let bpm = 180.;
let beat = 60. / bpm;

let stutter = @Audio fn trig_sig active beat_length subdiv rate inp ->
  let live = delay_line 4.;
  let size = array_size live;
  let segment = beat_length * subdiv;
  let length = Math.max 8. (segment / spf);
  let write_index = [| 0 |];
  let start_index = [| 0. |];
  let state = [| 0., 0. |];

  let write = write_index[0];
  let start = start_index[0];
  let playhead = state[0];
  live[write] := inp;

  let retrigger = Double (trig_sig == 1.);
  let capture = retrigger * write + (1. - retrigger) * start;
  let position = retrigger * (length - 1.) + (1. - retrigger) * playhead;
  let chunk = tabread_samp live (capture - length + 1. + position);
  let playing = Double (active == 1.);
  let output = playing * chunk + (1. - playing) * inp;

  let next = position + rate;
  let wraps = Math.floor (next / length);
  let next_position = next - length * wraps;
  start_index[0] := capture;
  let keep_playing = Double (active >= 0.5);
  state[0] := keep_playing * next_position + (1. - keep_playing) * playhead;
  state[1] := trig_sig;
  write_index[0] := (write + 1) % size;
  output
;;

# let bit_reduce = @Audio fn depth inp ->
#   inp * depth |> Math.round |> (/) depth 
# ;;
# Bit-depth reduction. Args: bits (1..24), input.
let bitcrush = @Audio fn bits inp ->
  let levels = Math.pow 2. (bits - 1.) in
  Math.floor (inp * levels + 0.5) / levels
;;

# Effect processor selected by the `sel` parameter:
#   0.        -> dry (bypass)
#   [1., 2.)  -> comb filter
#   [2., 3.)  -> lowpass filter
#   ...       -> further ranges reserved for more effects
#
# A 1-sample trigger is generated every time `sel` enters a new range
# (`changed (Math.floor sel)`); it feeds the active effect, and that effect
# stops when `sel` moves out of its range.

let fx = @Audio fn sel tr subdiv beat_len rate inp ->
  let range = Math.round (Math.floor sel);     # integer range index
  let rr = inp + (inp * (Double (sel == 5.)) |> Filter.hpf 1000. 1. |> Reverb.concert);

  let cc = 
    rr |> comb (lfnoise 2. 0.001 0.04) 0.1 0.8;

  let rm = 
    rr * sin_osc (lfnoise0 (1. / beat_len) 1000. 3000.);

  let fl =
    rr
    |> (*) 3. |> Math.tanh
    |> Filter.lpf (lfnoise 4. 50. 1000.) 5.
    ;

  let stutt = rr |> stutter tr ((sel == 6.) |> Double) beat_len subdiv rate;

  let sig = match sel with
    | 0. -> rr                               # dry
    | 1. -> cc
    | 2. -> fl 
    | 3. -> rm
    | 4. -> rr |> Filter.hpf (lfnoise 3. 800. 2000.) 4.
    | 6. -> stutt
    | 7. -> rr |> bitcrush (lfnoise 2. 1. 4.)
    | _ -> rr
    ;

  sig 
  |> glue -12. 4. 0.005 0.15 6. 3.
 # |> stutter (changed sel) (1.) beat_len subdiv rate

;;

let glitch = fx 0. 0. 1. beat 1. 0. |> play_node;

let Drums = module () ->
  let bufs = [|
    "~/Sounds/renoise-3.5.4-samples/HiHats/Closed Hat/tight_synther.flac", #0: hh
    "~/Sounds/renoise-3.5.4-samples/Kicks/Hard/offered.flac", #1: kick
    "~/Sounds/renoise-3.5.4-samples/Snares/Thin/xb_snare_052.flac", #2: snare
  |] |> Arrays.map (SF.load_sf);

  let _ = print `loaded {array_size bufs} buffers\n`;

  let kds = @Audio fn () -> 
    let rate = 1.;
    let f = bufs[1]; 
    let t = trig 0;

    t
    |> bufplay f.data (f.samplerate * spf) 0.
    |> (*) (t |> rect 0.1 |> adsr 0. 0. 1. 0.01 |> kill_on_end)
    |> (*) (Math.db_amp 6.)
  ;;

  let k = fn dur note plist ->
    kds () |> play_node;
    ()
  ;;
  let retrig_param = fn spl params i ->
    if i >= array_size params then 0.
    else (
      let name, value = params[i];
      if name == 'r' then Double value / spl
      else retrig_param spl params (i + 1)
    )
  ;;

  let vel_param = fn spl params i ->
    if i >= array_size params then 1.
    else (
      let name, value = params[i];
      if name == 'v' then Double value / 256.
      else vel_param spl params (i + 1)
    )
  ;;

  let snrs = @Audio fn retrigf rate vel -> 
    let f = bufs[2]; 
    let t = trig 0;

    (trig retrigf)
    |> bufplay f.data (f.samplerate * spf * rate) 0.
    |> (*) (t |> rect 0.1 |> adsr 0. 0. 1. 0.01 |> kill_on_end)
    |> (*) vel
  ;;

  let s = fn ctx dur note plist ->
    let retrig = retrig_param ctx.spl plist 0;
    let vel = vel_param ctx.spl plist 0;
    # snrs retrig ((Double note) - 60. |> midiratio) vel |> play_node;
    snrs retrig ((Double note) - 60. |> midiratio) vel ~> glitch; 
    ()
  ;;

  let hhs = @Audio fn retrigf -> 
    let rate = 1.;
    let hbuf = bufs[0]; 
    let t = trig 0;

    (trig retrigf)
    |> bufplay hbuf.data (hbuf.samplerate * spf) 0.
    |> (*) (t |> rect 0.05 |> adsr 0. 0. 1. 0.01 |> kill_on_end)
    |> pan 2 (rand_trig 0. 1. t)
  ;;


  let hh = fn ctx dur note plist ->
    # hhs () |> play_node;

    let spl = ctx.spl;
    # print `spl: {spl}\n`;
    let retrig = retrig_param spl plist 0;
    hhs retrig ~> glitch;
    ()
  ;;

  let hh2s = @Audio fn retrigf -> 
    let rate = 1.5;
    let f = bufs[0]; 
    let t = trig 0;

    (trig retrigf)
    |> bufplay f.data (rate * f.samplerate * spf) 0.
    |> (*) (t |> rect 0.05 |> adsr 0. 0. 1. 0.01 |> kill_on_end)

    |> pan 2 (rand_trig 0. 1. t)
    # |> (*) (Math.db_amp 12.)
  ;;

  let hh2 = fn ctx dur note plist ->
    let retrig = retrig_param ctx.spl plist 0;
    hh2s retrig ~> glitch;
    ()
  ;;

;

let mels = module () ->

  let cymbal = @Audio fn freq ->
    let t = trig 0;

    (pink () 
      |> Filter.bpf freq 16.
      |> (*) (Math.db_amp 40.)
    )
    |> (*) (t |> rect 0.5 |> adsr 0. 0.1 0.2 1. |> kill_on_end)
    |> (*) (Math.db_amp -15.)
  ;;

  let tri_synth = @Audio fn freq ->
    let t = trig 0;

    tri_osc (freq * (~[1., 1.01]))
    |> sum
    |> Filter.lpf (freq * 4.) 1.
    |> (*) (t |> rect 0.5 |> adsr 0. 0.1 0.2 1. |> kill_on_end)
    |> (*) (Math.db_amp -10.)
  ;;
  let r = Reverb.cathedral 0. |> play_node;

  let play = fn dur note plist ->
    let f = Double note |> midi_freq;
    cymbal f ~> r;
    # cymbal f ~> r;
    ()
  ;;

  let play_tri = fn dur note plist ->
    let f = Double note |> midi_freq;
    tri_synth f ~> r;
    # cymbal f ~> r;
    ()
  ;;

;


