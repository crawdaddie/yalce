open libs/audio_jit/DSP;
import libs/audio_jit/SF;
import Tracker;
import std/Lists;
import std/Arrays;

let open_file = extern fn String -> String -> Option of Ptr;
let fclose = extern fn Ptr -> ();
let read_bytes = extern fn Ptr -> String;



let bpm = 180.;
let beat = 60. / bpm;
let Drums = module () ->
  let bufs = [|
    "~/Sounds/rns_samples/HiHats/Closed/dh_clhat_tight_synther.flac",
    "~/Sounds/rns_samples/Kicks/ech_kick_resample.flac",
    # "~/Sounds/rns_samples/Snares/dh_snr_hi_grainy.flac",
    "~/Sounds/renoise-3.5.4-samples/Snares/Bodied/reggae.flac",
    "~/Sounds/rns_samples/HiHats/Closed/dh_clhat_tight_nospace.flac",
    "~/Sounds/rns_samples/HiHats/Closed/dh_clhat_tight_tecno.flac",
    "~/Sounds/rns_samples/HiHats/Closed/ech_hat_verydirty.flac",
    "~/Sounds/rns_samples/HiHats/Cymbal/dh_cym_ride_sweet.flac",
    "~/Sounds/rns_samples/HiHats/Open/dh_ophat_long_ender.flac",
    "~/Sounds/rns_samples/Kicks/dh_kick_mid_tighter.flac",
    "~/Sounds/rns_samples/Snares/dh_snr_hi_enveloper.flac",
    "~/Sounds/rns_samples/Snares/dh_snr_syn_808er.flac",
    "~/Sounds/rns_samples/Snares/dh_snr_syn_whitenoise.flac",
    "~/Sounds/rns_samples/Snares/ech_snare_analog.flac",
    "~/Sounds/rns_samples/Percussion/dh_perc_click_metal.flac",
    "~/Sounds/rns_samples/Percussion/ech_perc_909tom.flac",
    "~/Sounds/rns_samples/Toms/dh_perc_tom_wave.flac",
    "~/Sounds/rns_samples/Claps/ech_clap_vinyl909.flac",
  |] |> Arrays.map (SF.load_sf);

  let _ = print `loaded {array_size bufs} buffers\n`;

  let kds = @Audio fn () -> 
    let rate = 1.;
    let f = bufs[1]; 
    let t = trig 0;

    t
    |> bufplay f.data (f.samplerate * spf) 0.
    |> (*) (t |> rect 0.1 |> adsr 0. 0. 1. 0.01 |> kill_on_end)
    |> (*) (Math.db_amp 12.)
  ;;

  let k = fn dur note plist ->
    kds () |> play_node;
    ()
  ;;
  let retrig_param = fn spl params i ->
    if i >= array_size params then 0.
    else (
      let name, value = params[i];
      if name == 'r' then Double value / spl
      else retrig_param spl params (i + 1)
    )
  ;;

  let vel_param = fn spl params i ->
    if i >= array_size params then 1.
    else (
      let name, value = params[i];
      if name == 'v' then Double value / 256.
      else vel_param spl params (i + 1)
    )
  ;;

  let snrs = @Audio fn retrigf rate vel -> 
    let f = bufs[2]; 
    let t = trig 0;

    (trig retrigf)
    |> bufplay f.data (f.samplerate * spf * rate) 0.
    |> (*) (t |> rect 0.1 |> adsr 0. 0. 1. 0.01 |> kill_on_end)
    |> (*) vel
  ;;

  let s = fn ctx dur note plist ->
    let retrig = retrig_param ctx.spl plist 0;
    let vel = vel_param ctx.spl plist 0;
    snrs retrig ((Double note) - 60. |> midiratio) vel |> play_node;
    ()
  ;;

  let hhs = @Audio fn retrigf -> 
    let rate = 1.;
    let hbuf = bufs[0]; 
    let t = trig 0;

    (trig retrigf)
    |> bufplay hbuf.data (hbuf.samplerate * spf) 0.
    |> (*) (t |> rect 0.05 |> adsr 0. 0. 1. 0.01 |> kill_on_end)
    |> pan 2 (rand_trig 0. 1. t)
  ;;


  let hh = fn ctx dur note plist ->
    # hhs () |> play_node;

    let spl = ctx.spl;
    # print `spl: {spl}\n`;
    let retrig = retrig_param spl plist 0;
    hhs retrig |> play_node;
    ()
  ;;

  let hh2s = @Audio fn retrigf -> 
    let rate = 1.5;
    let f = bufs[0]; 
    let t = trig 0;

    (trig retrigf)
    |> bufplay f.data (rate * f.samplerate * spf) 0.
    |> (*) (t |> rect 0.05 |> adsr 0. 0. 1. 0.01 |> kill_on_end)

    |> pan 2 (rand_trig 0. 1. t)
    # |> (*) (Math.db_amp 12.)
  ;;

  let hh2 = fn ctx dur note plist ->
    let retrig = retrig_param ctx.spl plist 0;
    hh2s retrig |> play_node;
    ()
  ;;

;

let mels = module () ->

  let cymbal = @Audio fn freq ->
    let t = trig 0;

    (pink () 
      |> Filter.bpf freq 16.
      |> (*) (Math.db_amp 40.)
    )
    |> (*) (t |> rect 0.5 |> adsr 0. 0.1 0.2 1. |> kill_on_end)
    |> (*) (Math.db_amp -15.)
  ;;

  let tri_synth = @Audio fn freq ->
    let t = trig 0;

    tri_osc (freq * (~[1., 1.01]))
    |> sum
    |> Filter.lpf (freq * 4.) 1.
    |> (*) (t |> rect 0.5 |> adsr 0. 0.1 0.2 1. |> kill_on_end)
    |> (*) (Math.db_amp -10.)
  ;;
  let r = Reverb.cathedral 0. |> play_node;

  let play = fn dur note plist ->
    let f = Double note |> midi_freq;
    cymbal f ~> r;
    # cymbal f ~> r;
    ()
  ;;

  let play_tri = fn dur note plist ->
    let f = Double note |> midi_freq;
    tri_synth f ~> r;
    # cymbal f ~> r;
    ()
  ;;

;


