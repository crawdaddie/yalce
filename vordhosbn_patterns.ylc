let spl = beat / 2.;
import std/Str;


import std/Str;
import std/Arrays;
let pats = match open_file "./vordhosbn.csv" "rb" with
  | Some fd -> read_bytes fd |> Tracker.CSV.split_pats |> Arrays.map (Tracker.parse_pattern)
  | None -> [| |]
  ;

print `computed {array_size pats} patterns\n`;

# let spl = beat / 2.;

let handle_pat_ev = fn ctx note_dur note instr plist ->
  match instr with
  | 0 -> mels.play note_dur note plist
  | 2 -> mels.play_tri note_dur note plist
  | 3 -> Drums.k note_dur note plist
  | 4 -> Drums.hh ctx note_dur note plist
  | 5 -> Drums.hh2 ctx note_dur note plist
  | 6 -> Drums.s ctx note_dur note plist
  | _ -> ()
;;


let g = fn () ->

  let spl = beat / 2.;
  pats[0]
  |> Tracker.pattern_cor_ctx (bpm: 180., spl: (beat / 2.), logical_time: 0. ) 0
  |> cor_map (Tracker.handle_ev_ctx handle_pat_ev)
  |> play_pattern 0.
  ;

  yield 16. * beat;
  let m1 = fn () ->

    pats[1]
    |> Tracker.pattern_cor_ctx (bpm: 180., spl: (beat / 2.), logical_time: 0. ) 0
    |> cor_map (Tracker.handle_ev_ctx handle_pat_ev)
    |> cor_repeat 2
    |> play_pattern 0.
    ;

    pats[2]
    |> Tracker.pattern_cor_ctx (bpm: 180., spl: (beat / 4.), logical_time: 0. ) 0
    |> cor_map (Tracker.handle_ev_ctx handle_pat_ev)
    |> cor_repeat 2 
    |> play_pattern 0.
    ;

    yield 32. * beat;
    yield m1 ()
  ;;

  let stut_sched = fn a -> 
    let d = Math.array_choose [| 1., 1.5, 0.75, 0.5, 0.25 |];
    yield (d, a);
    # yield (1., a);
    yield stut_sched (a + d)
  ;;

  stut_sched 0.
  |> cor_map_opt (fn (d, a) ->
    match a < 16. with
    | true -> (
      # print `{Math.array_choose [|0., 1., 2., 3.|]}\n`;
      # let sel = Math.array_choose [|0., 1., 2., 3.|];
      set_input_scalar glitch 0 (Double (Math.rand_int 12)); 
      # set_input_scalar g 0 6.;
      set_input_scalar glitch 2 (Math.array_choose [|1.5, 0.75, 0.75, 0.75, 0.25, 0.25, 0.5, 0.125,|]) ;
      set_input_scalar glitch 4 (Math.array_choose [|1., 1., 1., 2., -1.|]) ;
      set_input_trig glitch 1;
      Some (d * beat)
    )
    | _ -> None
  )
  |> cor_loop
  |> play_pattern 0.;

  yield m1 ()
 # yield g ()
;;

g () |> play_pattern beat;
