let open_file = extern fn String -> String -> Option of Ptr;
let fclose = extern fn Ptr -> ();
let read_bytes = extern fn Ptr -> String;
# let read_lines = extern fn Ptr -> (List of String, Int);
#
# let (lines,n) = match open_file "~/projects/yalce/aoc/aoc_2019/day01.txt" "rb" with
#   | Some fd -> read_lines fd
#   | None -> (["",], 0)
#   ;
let spl = beat / 2.;
import std/Str;
let split_pats = fn st ->
  let len = array_size st;
  let count = [|1|];

  for i = 0 .. len in (
    if i > 0 && i + 1 < len && st[i] == '#' && st[i + 1] == '%' then
      count[0] := count[0] + 1
  );

  let result = array_fill_zeroes (count[0]) "";
  let start = [|0|];
  let out = [|0|];

  for i = 0 .. len in (
    if i > 0 && i + 1 < len && st[i] == '#' && st[i + 1] == '%' then (
      result[out[0]] := st[start[0] .. i];
      out[0] := out[0] + 1;
      start[0] := i
    )
  );

  result[out[0]] := st[start[0] .. len];
  result
;;

import std/Str;
import std/Arrays;
let pats = match open_file "./vordhosbn.csv" "rb" with
  | Some fd -> read_bytes fd |> split_pats |> Arrays.map (Tracker.parse_pattern)
  | None -> [| |]
  ;

# print `computed {array_size pats} patterns\n`

# let spl = beat / 2.;

let handle_pat_ev = fn note_dur note instr plist -> 
  # match scan_for_delay plist with
  # | 0. ->
  # | d ->  
  match instr with
  | 0 -> mels.play note_dur note plist
  | 2 -> mels.play_tri note_dur note plist
  | 3 -> Drums.k note_dur note plist
  | 4 -> Drums.hh note_dur note plist
  | 5 -> Drums.hh2 note_dur note plist
  | 6 -> Drums.s note_dur note plist
  | _ -> ()
;;

let g = fn () ->
  let spl = beat / 2.;
  pats[0]
  |> Tracker.pattern_cor 0
  |> cor_map (fn (d, ev) -> 
    Tracker.handle_ev 
      handle_pat_ev
      spl
      ev;
    d * spl 
  )
  |> cor_repeat 2
  |> play_pattern 0.
  ;

  yield 32. * beat;

  let m1 = fn () ->
    pats[1]
    |> Tracker.pattern_cor 0
    |> cor_map (fn (d, ev) -> 
      Tracker.handle_ev 
        handle_pat_ev
        spl
        ev;
      d * spl
    )
    |> cor_repeat 2
    |> play_pattern 0.
    ;

    pats[2]
    |> Tracker.pattern_cor 0
    |> cor_map (fn (d, ev) -> 
      Tracker.handle_ev 
        handle_pat_ev
        (spl * 0.5)
        ev;
      d * spl * 0.5
    )
    |> cor_repeat 2 
    |> play_pattern 0.
    ;
    yield 32. * beat;
    yield m1 ()
  ;;

  yield m1 ()
 # yield g ()
;;

g () |> play_pattern beat;


