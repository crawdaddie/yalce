import std/Math;


let Filter = module () ->

let _min = fn a: (Double) b: (Double) -> Math.min a b;;
let biquad = @Audio fn b0 b1 b2 a1 a2 x ->
  let X = [| 0., 0. |];
  let Y = [| 0., 0. |];
  let y = b0 * x + b1 * X[0] + b2 * X[1] - a1 * Y[0] - a2 * Y[1];
  X[1] := X[0];
  X[0] := x;
  Y[1] := Y[0];
  Y[0] := y;
  y
;;

# basic 1st-order IIR filter
let iir1 = @Audio fn b0 b1 a1 x ->
  let X = [| 0. |];
  let Y = [| 0. |];
  let y = b0 * x + b1 * X[0] - a1 * Y[0];
  X[0] := x;
  Y[0] := y;
  y
;;

let allpass = @Audio fn freq x ->
  let k = Math.tan (Math.PI * freq * spf) in
  let a = (k - 1.0) / (k + 1.0) in
  iir1 a 1.0 a x
;;

let lpf = @Audio fn freq q x ->
  let w0   = 2.0 * Math.PI * freq * spf in
  let cosw = Math.cos w0 in
  let sinw = Math.sin w0 in
  let alpha = sinw / (2.0 * q) in

  let b0 = (1.0 - cosw) / 2.0 in
  let b1 = 1.0 - cosw in
  let b2 = (1.0 - cosw) / 2.0 in
  let a0 = 1.0 + alpha in
  let a1 = -2.0 * cosw in
  let a2 = 1.0 - alpha in

  let b0n = b0 / a0 in
  let b1n = b1 / a0 in
  let b2n = b2 / a0 in
  let a1n = a1 / a0 in
  let a2n = a2 / a0 in

  biquad b0n b1n b2n a1n a2n x
;;

let hpf = @Audio fn freq q x ->
  let w0   = 2.0 * Math.PI * freq * spf in
  let cosw = Math.cos w0 in
  let sinw = Math.sin w0 in
  let alpha = sinw / (2.0 * q) in

  let b0 = (1.0 + cosw) / 2.0 in
  let b1 = -1 * (1.0 + cosw) in
  let b2 = (1.0 + cosw) / 2.0 in
  let a0 = 1.0 + alpha in
  let a1 = -2.0 * cosw in
  let a2 = 1.0 - alpha in

  let b0n = b0 / a0 in
  let b1n = b1 / a0 in
  let b2n = b2 / a0 in
  let a1n = a1 / a0 in
  let a2n = a2 / a0 in

  biquad b0n b1n b2n a1n a2n x
;;

let bpf = @Audio fn freq q x ->
  let w0   = 2.0 * Math.PI * freq * spf in
  let cosw = Math.cos w0 in
  let sinw = Math.sin w0 in
  let alpha = sinw / (2.0 * q) in

  let b0 =  alpha in
  let b1 =  0.0 in
  let b2 = -1 * alpha in
  let a0 =  1.0 + alpha in
  let a1 = -2.0 * cosw in
  let a2 =  1.0 - alpha in

  let b0n = b0 / a0 in
  let b1n = b1 / a0 in
  let b2n = b2 / a0 in
  let a1n = a1 / a0 in
  let a2n = a2 / a0 in

  biquad b0n b1n b2n a1n a2n x
;;

let notch = @Audio fn freq q x ->
  let w0   = 2.0 * Math.PI * freq * spf in
  let cosw = Math.cos w0 in
  let sinw = Math.sin w0 in
  let alpha = sinw / (2.0 * q) in

  let b0 =  1.0 in
  let b1 = -2.0 * cosw in let b2 =  1.0 in
  let a0 =  1.0 + alpha in
  let a1 = -2.0 * cosw in
  let a2 =  1.0 - alpha in

  let b0n = b0 / a0 in
  let b1n = b1 / a0 in
  let b2n = b2 / a0 in
  let a1n = a1 / a0 in
  let a2n = a2 / a0 in

  biquad b0n b1n b2n a1n a2n x
;;

let lowshelf = @Audio fn freq q gain_db x ->
  let w0   = 2.0 * Math.PI * freq * spf in
  let cosw = Math.cos w0 in
  let sinw = Math.sin w0 in
  let A = Math.pow 10.0 (gain_db / 40.0) in
  let alpha = sinw / (2.0 * q) in
  let sqrtA = Math.sqrt A in

  let b0 = A * ( (A + 1.0) - (A - 1.0) * cosw + 2.0 * sqrtA * alpha ) in
  let b1 = 2.0 * A * ( (A - 1.0) - (A + 1.0) * cosw ) in
  let b2 = A * ( (A + 1.0) - (A - 1.0) * cosw - 2.0 * sqrtA * alpha ) in
  let a0 = (A + 1.0) + (A - 1.0) * cosw + 2.0 * sqrtA * alpha in
  let a1 = -2.0 * ( (A - 1.0) + (A + 1.0) * cosw ) in
  let a2 = (A + 1.0) + (A - 1.0) * cosw - 2.0 * sqrtA * alpha in

  let b0n = b0 / a0 in
  let b1n = b1 / a0 in
  let b2n = b2 / a0 in
  let a1n = a1 / a0 in
  let a2n = a2 / a0 in

  biquad b0n b1n b2n a1n a2n x
;;

let highshelf = @Audio fn freq q gain_db x ->
  let w0   = 2.0 * Math.PI * freq * spf in
  let cosw = Math.cos w0 in
  let sinw = Math.sin w0 in
  let A = Math.pow 10.0 (gain_db / 40.0) in
  let alpha = sinw / (2.0 * q) in
  let sqrtA = Math.sqrt A in

  let b0 = A * ( (A + 1.0) + (A - 1.0) * cosw + 2.0 * sqrtA * alpha ) in
  let b1 = -2.0 * A * ( (A - 1.0) + (A + 1.0) * cosw ) in
  let b2 = A * ( (A + 1.0) + (A - 1.0) * cosw - 2.0 * sqrtA * alpha ) in
  let a0 = (A + 1.0) - (A - 1.0) * cosw + 2.0 * sqrtA * alpha in
  let a1 = 2.0 * ( (A - 1.0) - (A + 1.0) * cosw ) in
  let a2 = (A + 1.0) - (A - 1.0) * cosw - 2.0 * sqrtA * alpha in

  let b0n = b0 / a0 in
  let b1n = b1 / a0 in
  let b2n = b2 / a0 in
  let a1n = a1 / a0 in
  let a2n = a2 / a0 in

  biquad b0n b1n b2n a1n a2n x
;;

let peak = @Audio fn freq q gain_db x ->
  let w0   = 2.0 * Math.PI * freq * spf in
  let cosw = Math.cos w0 in
  let sinw = Math.sin w0 in
  let alpha = sinw / (2.0 * q) in
  let A = Math.pow 10.0 (gain_db / 40.0) in

  let b0 = 1.0 + alpha * A in
  let b1 = -2.0 * cosw in
  let b2 = 1.0 - alpha * A in
  let a0 = 1.0 + alpha / A in
  let a1 = -2.0 * cosw in
  let a2 = 1.0 - alpha / A in

  let b0n = b0 / a0 in
  let b1n = b1 / a0 in
  let b2n = b2 / a0 in
  let a1n = a1 / a0 in
  let a2n = a2 / a0 in

  biquad b0n b1n b2n a1n a2n x
;;

let pole = @Audio fn g x z ->
  let y = z + g * (x - z) in
  y
;;

let lpf1p = @Audio fn freq x ->
  let Z = [| 0. |];
  let g = _min 0.999 (2.0 * Math.PI * freq * spf );
  let y = Z[0] |> pole g x;
  Z[0] := y;
  y
;;

let hpf1p = @Audio fn freq x ->
  let Z = [| 0. |];
  let g = _min 0.999 (2.0 * Math.PI * freq * spf);
  let lp = Z[0] |> pole g x;
  Z[0] := lp;
  x - lp
;;

let ladder = @Audio fn cutoff res drive x ->
  let Z = [| 0., 0., 0., 0. |];  # z1..z4
  let g = 2.0 * Math.PI * cutoff * spf in
  let g1 = _min 0.99 g in

  # input drive + feedback
  let u = Math.tanh (drive * x - (res * (Z[3]))) in

  let y1 = Z[0] |> pole g1 u in
  let y2 = Z[1] |> pole g1 y1 in
  let y3 = Z[2] |> pole g1 y2 in
  let y4 = Z[3] |> pole g1 y3 in

  Z[0] := y1 in
  Z[1] := y2 in
  Z[2] := y3 in
  Z[3] := y4 in

  y4
;;

let allpass2 = @Audio fn freq q x ->
  let w0 = 2.0 * Math.PI * freq * spf in
  let cosw = Math.cos w0 in
  let sinw = Math.sin w0 in
  let alpha = sinw / (2.0 * q) in

  let a0 = 1.0 + alpha in
  let a1 = (-2.0 * cosw) / a0 in
  let a2 = (1.0 - alpha) / a0 in

  biquad a2 a1 1.0 a1 a2 x
;;

let dispersion32 = @Audio fn base amount x ->
  x |> dsp_iter.int_fold (fn i acc ->
    let fi = i + 1 in
    let f = base * Math.pow 1.18 fi in
    let q = 1.2 + amount * 24.0 / fi in
    acc |> allpass2 f q
  ) 32
;;
;

let white = @Audio fn () ->
  Math.rrand -1. 1.
;;

let Reverb = module () ->

# 1. Schroeder (parallel combs -> allpass chain)
let schroeder = @Audio fn room damp x ->
  let room_scale = room;
  let fb = damp;
  # 4 parallel comb filters for the reverb body
  let body =
    dsp_iter.list_foldi
      (fn i acc t -> acc + comb (t * room_scale) 4.0 fb x)
      [0.0297, 0.0371, 0.0411, 0.0437]
      0.
    |> (*) 0.25
  in
  # 2 delay-line allpasses in series; delay times are seconds
  body |> dl_allpass 0.005  0.05 0.5
       |> dl_allpass 0.0017 0.05 0.5
;;

# 2. Early reflections + diffuse tail
let early_refl = @Audio fn x ->
  # Sparse parallel delays, no feedback → the "room click" character
  dsp_iter.list_fold (fn acc t -> acc + dl_allpass t 0.1 0. x) 
  [0.0073, 0.0119, 0.0169, 0.0223, 0.0281, 0.0341]
  0.
  |> (*) 0.167
;;

let reverb = @Audio fn room damp x ->
  let early = early_refl (x * 0.4) in
  let late  = schroeder room damp (x * 0.6) in
  early + late
;;


# 3. Allpass chain ("plate"-style diffuse sound)
# Pure allpass chains don't color the spectrum, giving a smoother, plate-like texture:
let plate = @Audio fn fb x ->
  # Pre-diffusion: smear the input before the tank
  let pre = x |> dl_allpass 0.0048 0.05 0.75
              |> dl_allpass 0.0036 0.05 0.625
              |> dl_allpass 0.0127 0.05 0.7
  in
  # Tank: two allpass loops in series approximate a reverb tail
  pre
  |> dsp_iter.list_fold (fn acc t -> acc |> dl_allpass t 0.15 fb) [0.0672, 0.0100, 0.0442, 0.0908, 0.0100, 0.0400]
;;

# 4. Adding tone shaping — absorptive reverb by LP-filtering the comb feedback:
let absorb_comb = @Audio fn t damp input ->
  # High frequencies decay faster by LP-ing the recirculating signal
  let Z = [| 0. |];
  let fed = Z[0] |> Filter.lpf1p (8000. * (1. - damp));
  let y = input + fed;
  Z[0] := comb t 0.1 0.8 y;
  y
;;

let matrix_vec_mul_double = extern fn Int -> Int -> Array of Double -> Array of Double -> Array of Double -> Array of Double;
let vec_dot_double        = extern fn Array of Double -> Array of Double -> Double;

let fdn4 = @Audio fn d1 d2 d3 d4 rt60 inp ->

  let M = [|
    -0.5,  0.5,  0.5,  0.5,
     0.5, -0.5,  0.5,  0.5,
     0.5,  0.5, -0.5,  0.5,
     0.5,  0.5,  0.5, -0.5
  |];

  let b = array_fill_const 4 1.;
  let c = array_fill_const 4 0.25;


  let dls = [|
    (delay_line 1., d1),
    (delay_line 1., d2),
    (delay_line 1., d3),
    (delay_line 1., d4),
  |];
  let (dl0, _) = dls[0];
  let max_size = array_size dl0;
  let counter = [| 0 |];
  let w = counter[0];

  let y = dsp_iter.array_map (fn (dl, dt) -> 
    tabread_samp dl (w - ( dt / spf ))
  ) dls;

  let mmy = array_fill_const 4 0. |> matrix_vec_mul_double 4 4 M y;

  dsp_iter.array_mapi (fn i (dl, dt) ->
    dl[w] := inp * b[i] + (
      mmy[i]
      |> (*) (Math.pow 10.0 ((-3.0 * dt) / rt60)) # per-delay-line gamma output gain
      # |> Filter.lpf1p 15000
      # |> Filter.hpf1p 200
    )
  ) dls;


  counter[0] := (w + 1) % max_size;

  inp + (vec_dot_double c y)

;;



# Studio room (~0.5s rt60)
let room_fdn4 = @Audio fn inp ->
  fdn4 0.0199 0.0291 0.0440 0.0653 0.5 inp
;;

# Concert hall (~2s rt60)
let concert_fdn4 = @Audio fn inp ->
  fdn4 0.0527 0.0787 0.1171 0.1733 2.0 inp
;;

# Cathedral (~5s rt60)
let cathedral_fdn4 = @Audio fn inp ->
  fdn4 0.1249 0.1873 0.2797 0.4177 5.0 inp
;;
let fdn8 = @Audio fn d1 d2 d3 d4 d5 d6 d7 d8 rt60 inp ->

  # 8x8 generalised conference matrix: M = (2/8)*J - I
  # diagonal = -3/4, off-diagonal = 1/4 — orthogonal, lossless
  let M = [|
    -0.75,  0.25,  0.25,  0.25,  0.25,  0.25,  0.25,  0.25,
     0.25, -0.75,  0.25,  0.25,  0.25,  0.25,  0.25,  0.25,
     0.25,  0.25, -0.75,  0.25,  0.25,  0.25,  0.25,  0.25,
     0.25,  0.25,  0.25, -0.75,  0.25,  0.25,  0.25,  0.25,
     0.25,  0.25,  0.25,  0.25, -0.75,  0.25,  0.25,  0.25,
     0.25,  0.25,  0.25,  0.25,  0.25, -0.75,  0.25,  0.25,
     0.25,  0.25,  0.25,  0.25,  0.25,  0.25, -0.75,  0.25,
     0.25,  0.25,  0.25,  0.25,  0.25,  0.25,  0.25, -0.75,
  |];
  let b = array_fill_const 8 1.;
  let c = array_fill_const 8 0.125;

  let dls = [|
    (delay_line 1, d1),
    (delay_line 1, d2),
    (delay_line 1, d3),
    (delay_line 1, d4),
    (delay_line 1, d5),
    (delay_line 1, d6),
    (delay_line 1, d7),
    (delay_line 1, d8),
  |];

  let dl0, _ = dls[0];
  let max_size = array_size dl0;

  let counter = [| 0 |];
  let w = counter[0];

  let y = dsp_iter.array_map (fn (dl, dt) ->
    tabread_samp dl (w - dt / spf)
  ) dls;

  let mmy = array_fill_const 8 0. |> matrix_vec_mul_double 8 8 M y;


  dsp_iter.array_mapi (fn i (dl, dt) ->
    dl[w] := inp * b[i] + (
      mmy[i]
      |> (*) (Math.pow 10.0 ((-3.0 * dt) / rt60)) # per-delay-line gamma output gain
      |> Filter.lpf1p 15000
      |> Filter.hpf1p 200
    )
  ) dls;

  counter[0] := (w + 1) % max_size;
  inp + (vec_dot_double c y)
;;

let room = @Audio fn inp ->
  fdn8 0.0150 0.0189 0.0240 0.0307 0.0388 0.0491 0.0625 0.0792 0.5 inp
;;

let concert = @Audio fn inp ->
  fdn8 0.0397 0.0500 0.0638 0.0814 0.1027 0.1301 0.1656 0.2100 2.0 inp ;;

let cathedral = @Audio fn inp ->
  fdn8 0.0941 0.1188 0.1509 0.1925 0.2435 0.3083 0.3925 0.4975 5.0 inp
;;

let mega_cathedral = @Audio fn inp ->
  fdn8 0.0941 0.1188 0.1509 0.1925 0.2435 0.3083 0.3925 0.4975 10.0 inp
;;



