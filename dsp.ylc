let s = @Audio fn () ->
  let t = trig 0.5 ;
  let a = t |> decay 0.1 |> (*) (t |> arr_choose [|600., 600., 300., 450., 1000., 900.|] |> sin_osc)
  ;

  let t2 = trig 0.75 ;
  let b = t2 |> decay 0.1 |> (*) (t2 |> arr_choose [|600., 600., 300., 450., 1000., 900.|] |> sin_osc);
  a + b |> (*) 0.5 |> Reverb.schroeder 4. 0.9
