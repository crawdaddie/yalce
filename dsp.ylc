let s = @Audio fn f ->

  let ff = 60. * (1 + lfnoise 1 0 0.1);
  array_fill 8 (fn i -> ff * (1. + (0.02 * i) / 8))
  |> ~
  |> sq_osc
  |> mix 2
  |> (*) 0.5 
;;
# let Play = extern fn T -> T;

# let x = s 40 |> Play;
let x = s 40. |> play_node;


let co = fn () -> 
  yield 1.;
  yield 1.;
  yield 1.;
  yield 1.
  ;;

let play_pattern = extern fn T -> T;
co () |> play_pattern;



