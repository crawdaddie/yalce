let s = @Audio fn () ->

  let t = trig 1.;
  t |> decay 0.1 |> (*) (t |> arr_choose [|600., 600., 300., 450., 1000., 900.|] |> sin_osc)
  |> (*) 0.5 |> Reverb.mega_cathedral
;;

