let Audio = extern fn (T: (Double ... -> Double)) -> T;

# Table-lookup sine oscillator. Arg: frequency in Hz.

let ~ = extern fn Array of T -> T;
let sin_osc = extern fn Double -> Double;
let sq_osc = extern fn Double -> Double;
let saw_osc = extern fn Double -> Double;
let pm_osc = extern fn Double -> Double -> Double -> Double;
let phasor = extern fn Double -> Double;

# Resettable phasor. Args: frequency, trigger/reset signal.
# let phasor_sinc = extern fn Double -> Double -> Double;
# Impulse generator. Arg: trigger frequency; `0` is commonly used for a one-shot trigger.
let trig = extern fn Double -> Double;

# Emits a trigger when the input value changes.
let changed = extern fn Double -> Double;
# Read a table by normalized phase.
let tabread = extern fn Array of Double -> Double -> Double;
# Read a table by sample index.
let tabread_samp = extern fn Array of Double -> Double -> Double;
# Exponential decay envelope. Args: decay time, trigger.
let decay = extern fn Double -> Double -> Double;
# Unipolar scale from `[0, 1]` into `[lo, hi]`. Args: lo, hi, value.
let scale = extern fn Double -> Double -> Double -> Double;
# Bipolar scale from `[-1, 1]` into `[lo, hi]`. Args: lo, hi, value.
let scale_bp = extern fn Double -> Double -> Double -> Double;
let array_of_buf = extern fn Ptr -> Array of Double;
let bufsize = extern fn Ptr -> Int;
# Linearly interpolated low-frequency noise. Args: update frequency, low bound, high bound.
let lfnoise = extern fn Double -> Double -> Double -> Double;
# Stepped low-frequency noise. Args: update frequency, low bound, high bound.
let lfnoise0 = extern fn Double -> Double -> Double -> Double;
# Marks a signal as done when it reaches its natural end.
let kill_on_end = extern fn Double -> Double;
# ADSR envelope. Args: attack, decay, sustain, release, trigger.
let adsr = extern fn Double -> Double -> Double -> Double -> Double -> Double;
# Rectangular gate envelope. Args: duration, trigger.
let rect = extern fn Double -> Double -> Double;

let delay_line = extern fn Double -> Array of Double;
# Comb filter. Args: delay seconds, max delay seconds, feedback, input.
# Compile-time constant: arg 2 (`max delay`) must be a constant > 0.
let comb = extern fn Double -> Double -> Double -> Double -> Double;
# Delay-line allpass. Args: delay seconds, max delay seconds, feedback, input.
# Compile-time constant: arg 2 (`max delay`) must be a constant > 0.
let dl_allpass = extern fn Double -> Double -> Double -> Double -> Double;

# Buffer playback. Args: buffer, rate, start position, trigger.
let bufplay = extern fn Array of Double -> Double -> Double -> Double -> Double;
# Multichannel buffer playback. Args: channel count, buffer, rate, start position, trigger.
# Compile-time constant: arg 1 (`channel count`) must be a constant integer > 0.
let mbufplay = extern fn Int -> Array of Double -> Double -> Double -> Double -> Double;

# Granular playback. Args: max grains, source buffer, rate, position, width, trigger.
# Compile-time constant: arg 1 (`max grains`) must be a constant integer > 0.
let grains = extern fn Int ->       Array of Double -> Double -> Double -> Double -> Double -> Double;
# Granular playback with a separate envelope buffer.
# Args: max grains, source buffer, envelope buffer, rate, position, width, trigger.
# Compile-time constant: arg 1 (`max grains`) must be a constant integer > 0.
let grains_env = extern fn Int -> Array of Double -> Array of Double -> Double -> Double -> Double -> Double -> Double;

# Slew / lag processor. Args: lag time in seconds, input.
let lag = extern fn Double -> Double -> Double;
# On each trigger, choose a random element from the array.
let arr_choose = extern fn Array of Double -> Double -> Double;
# On each trigger, advance to the next element in the array.
let arr_seq = extern fn Array of Double -> Double -> Double;

let to_samps = extern fn Double -> Double;

let dsp_iter = module () ->
  # let int_fold = extern fn (R -> Int -> R) -> Int -> R -> R;
  let int_fold = extern fn (Int -> R -> R) -> Int -> R -> R;
  let int_foldi = extern fn (Int -> R -> R) -> Int -> R -> R;

  let list_map = extern fn (T -> R) -> List of T -> List of R;
  let list_fold = extern fn (R -> T -> R) -> List of T -> R -> R;
  let list_foldi = extern fn (Int -> R -> T -> R) -> List of T -> R -> R;

  let array_map = extern fn (T -> R) -> Array of T -> Array of R;
  let array_mapi = extern fn (Int -> T -> R) -> Array of T -> Array of R;
  let array_fold = extern fn (R -> T -> R) -> Array of T -> R -> R;
  let array_foldi = extern fn (Int -> R -> T -> R) -> Array of T -> R -> R;
;

let play_node = extern fn Ptr -> Ptr;

let _ = dlopen "libs/audio_jit/libaudio_jit.so";
# let s = @Audio fn freq ->
