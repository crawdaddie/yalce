let add = fn a b -> a + b;;
let consume_array = fn xs -> 0;;

let const_partial = fn y ->
  let add2 = add 2 in
  add2 y
;;

let local_partial = fn x ->
  let addx = add x in
  addx 40
;;

let make_adder = fn x ->
  add x
;;

let escaped_partial = fn x ->
  let addx = make_adder x in
  addx 40
;;

let closure_captured_array_cell = fn n ->
  let cell = [| [| n, n + 1 |] |];
  let use_cell = (fn () -> consume_array (cell[0])) in
  use_cell ()
;;

const_partial 40 + local_partial 2 + escaped_partial 2;
