open std/HashSet;

let IntSet = Set
  (fn x ->
    let xb = x |> asbytes ;
    hash_string (cstr xb) (array_size xb)
  )
  (==)
;

let test = module () ->
  let test1 = (
    let s = IntSet.new () in
    let s2 = IntSet.add 2 s in
    IntSet.contains 2 s && !IntSet.contains 3 s
  );

  let test2 = (
    let s = IntSet.new ()
    |> IntSet.add 2
    |> IntSet.add 3
    |> IntSet.add 4
    |> IntSet.add 5 
    |> IntSet.add 5 
    in
    IntSet.contains 2 s && IntSet.contains 3 s && !IntSet.contains 1 s && s.size == 4
  )
;;
