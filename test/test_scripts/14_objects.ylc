type RegexMatch = (rm_so: Uint64, rm_eo: Uint64);

type TensorRef = Array of TensorNode;

type TensorNode = (
  data: Array of Double,
  grad: Array of Double,
  shape: Array of Int,
  op: TensOp
);

type DirectNode = (
  value: Int,
  kids: List of DirectNode
);

type DirectArrayNode = (
  value: Int,
  kids: Array of DirectArrayNode
);

type ManagedArrayNode = (
  value: Int,
  weights: Array of Double,
  kids: Array of ManagedArrayNode
);

type ManagedArrayNodeRef = Array of ManagedArrayNode;

type ManagedTreeRef = Array of ManagedTreeNode;

type ManagedTreeOp =
  | ManagedTreeLeaf
  | ManagedTreeJoin of (ManagedTreeRef, ManagedTreeRef)
;

type ManagedTreeNode = (
  value: Int,
  weights: Array of Double,
  kids: ManagedTreeRef,
  op: ManagedTreeOp
);

type TensOp =
  | TensOpLeaf
  | TensOpAdd of (TensorRef, TensorRef)
  | TensOpMul of (TensorRef, TensorRef)
  | TensOpNeg of TensorRef
  | TensOpDiv of (TensorRef, TensorRef)
  | TensOpSum of TensorRef
  | TensOpMatMul of (TensorRef, TensorRef)
;

let tensor_make = fn data shape ->
  [| TensorNode data [| 0.|] shape TensOpLeaf |]
;;

let tensor_add = fn a: (TensorRef) b: (TensorRef) ->
  [| TensorNode [| 0.|] [| 0.|] [| 1 |] (TensOpAdd (a, b)) |]
;;

let direct_leaf = fn value ->
  DirectNode value []
;;

let direct_pair = fn a b ->
  DirectNode 3 [a, b]
;;

let direct_array_leaf = fn value ->
  DirectArrayNode value [| |]
;;

let direct_array_pair = fn a b ->
  DirectArrayNode 3 [| a, b |]
;;

let managed_array_leaf = fn value ->
  ManagedArrayNode value [| 1., 2. |] [| |]
;;

let managed_array_pair = fn a b ->
  ManagedArrayNode 3 [| 3., 4. |] [| a, b |]
;;

let managed_tree_leaf = fn value ->
  ManagedTreeNode value [| 1. |] [| |] ManagedTreeLeaf
;;

let managed_tree_join = fn left right ->
  ManagedTreeNode 9 [| 9. |] [| left, right |] (ManagedTreeJoin ([| left |], [| right |]))
;;

let test = module () ->

  let test_record_access = fn () ->
    let x = (
      a: 1,
      b: 2,
      f: (fn s: (Int) t: (Int) -> s + t)
    );
    x.f 1 2 == 3
  ;;

  let test_type_decl_rec_access = fn () ->
    let x = RegexMatch 0 0;
    x.rm_so == 0
  ;;

  let test_sizeof_type_exprs = fn () ->
    sizeof Int == 4 &&
    sizeof Double == 8 &&
    sizeof (type _ = Array of Double) == 16
  ;;

  let test_mutually_recursive_tensor_ref = fn () ->
    let t = tensor_make [| 1.|] [| 1 |];
    let t2 = tensor_add t t;
    array_size t2 == 1
  ;;

  let test_direct_recursive_record_list = fn () ->
    let a = direct_leaf 1;
    let b = direct_leaf 2;
    let p = direct_pair a b;
    match p.kids with
    | x::y::[] -> x.value == 1 && y.value == 2
    | _ -> false
  ;;

  let test_direct_recursive_record_array_pattern = fn () ->
    let a = direct_array_leaf 1;
    let b = direct_array_leaf 2;
    let p = direct_array_pair a b;
    match p.kids with
    | [| x, y |] -> x.value == 1 && y.value == 2
    | _ -> false
  ;;

  let test_recursive_managed_array_aggregate_pattern = fn () ->
    let a = managed_array_leaf 1;
    let b = managed_array_leaf 2;
    let p = managed_array_pair a b;
    match p.kids with
    | [| x, y |] ->
      x.value == 1 &&
      y.value == 2 &&
      array_size x.weights == 2 &&
      array_size y.weights == 2
    | _ -> false
  ;;

  let test_recursive_managed_array_aggregate_drop = fn () ->
    let a = managed_array_leaf 1;
    let b = managed_array_leaf 2;
    let roots = [| managed_array_pair a b, managed_array_pair b a |];
    array_size roots == 2
  ;;

  let test_recursive_sum_aggregate_payload = fn () ->
    let left = managed_tree_leaf 1;
    let right = managed_tree_leaf 2;
    let joined = managed_tree_join left right;
    match joined.op with
    | ManagedTreeJoin (ls, rs) ->
      array_size ls == 1 &&
      array_size rs == 1
    | _ -> false
  ;;

;
