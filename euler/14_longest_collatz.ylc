open std/HashSet;
let collatz = fn n ->
  # print `collatz {n}\n`;
  match n % 2 with
  | 0u64 -> n / 2
  | _ -> 3 * n + 1
  ;;


# uint64_t hash_uint64(uint64_t x) {
#   x ^= x >> 30;
#   x *= 0xbf58476d1ce4e5b9ULL;
#   x ^= x >> 27;
#   x *= 0x94d049bb133111ebULL;
#   x ^= x >> 31;
#   return x;
# }

let SeqLengthMap = Map 
    (fn () -> 0u64)
    (fn () -> 0)
    (fn x: (Uint64) ->
      let xb = x |> asbytes ;
      hash_string xb
    )
    (==)

    ;

let get_collatz_length = fn i n cache ->
  match SeqLengthMap.get n cache with
  | Some l -> i + l
  | None -> (
    let coll = collatz n;
    if coll == 1 then (
      i
    ) else (
      get_collatz_length (i + 1) coll cache
    )
  )
;;

let get_lengths = fn (start, seq_len) n cache ->
  match n with
  | 0u64 -> (start, seq_len)
  | _ -> (
    let len = get_collatz_length 0 n cache;
    let c = SeqLengthMap.set n len cache;
    let nl = if len >= seq_len then (n, len) else (start, seq_len); 
    get_lengths nl (n - 1) c
  )
;;

print `{get_lengths (0u64, 0) 1_000_000u64 (SeqLengthMap.new_sized 16384) }\n`;
