let queue_list_rev = fn l ->
  let aux = fn ll res ->
    match ll with
    | [] -> res
    | x::rest -> aux rest (x::res)
  ;;
  aux l []
;;

let of_list = fn l ->
  (l, [])
;;

let append = fn n (h, t) ->
  (h, n::t)
;;

let prepend = fn n (h, t) ->
  (n::h, t)
;;

let pop_left = fn (h, t) ->
  match h with
  | x::rest -> Some (x, (rest, t))  
  | [] -> (
    match queue_list_rev t with
    | [] -> None
    | x::rest -> Some (x, (rest, []))
  )
;;


let test = module () ->
  let test_int_queue =  
    let q = of_list [1,]
      |> append 2 
      |> append 3 
      |> append 4
    in
    match pop_left q with
      | Some (h, _) if h == 1 -> true  
      | _ -> false
      ;
;
