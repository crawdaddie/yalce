# let hash_string = extern fn Ptr -> Int -> Uint64 ;
let u64_bit_and = extern fn Uint64 -> Uint64 -> Uint64;
let u64_bit_xor = extern fn Uint64 -> Uint64 -> Uint64;
let u64_to_int = extern fn Uint64 -> Int;
let char_to_uint64 = extern fn Char -> Uint64;

let FNV_OFFSET = 14695981039346656037u64;
let FNV_PRIME = 1099511628211u64;

let hash_string = fn str ->
  let aux = fn h str ->
    match (array_size str) with
    | 0 -> h
    | _ -> (
      let c = str[0];
      aux (h |> u64_bit_xor (char_to_uint64 c) |> (*) FNV_PRIME) (array_succ str)
    )
  ;;
  aux FNV_OFFSET str
;;


let Set = module
  hash: (a -> Uint64)
  eq: (a -> a -> Bool) ->

  type S = (data: Array of List of a, size: Int);

  let new = fn () ->
    S (array_fill_const 256 []) 0
  ;;

  let new_sized = fn s ->
    S (array_fill_const s []) 0
  ;;

  let list_contains = fn x l ->
    match l with
    | [] -> false
    | y::rest -> if (eq x y) then true else (list_contains x rest)
  ;;

  let get_key_idx = fn x d -> hash x |> u64_bit_and ((array_size d) - 1) |> u64_to_int;;

  let add = fn x set ->                            
  # x : a, set : Array of (List of a)
    let key_idx = get_key_idx x set.data;
    let node_list = set.data[key_idx];
    match node_list |> list_contains x with
    | true -> set
    | false ->  (
      set.data[key_idx] := x::(set.data[key_idx]);
      S (set.data) (1 + set.size)
    )

  ;;


  let contains = fn x set ->                            
  # x : a, set : Array of (List of a)
    let key_idx = get_key_idx x set.data;
    let node_list = set.data[key_idx];
    node_list |> list_contains x
  ;;

  let of_list = fn l ->
    let aux = fn l s ->
      match l with
      | [] -> s
      | x::rest -> s |> add x |> aux rest
      
    ;;
    aux l @@ new ()
  ;;
;

let Map = module
  _key_witness: (() -> K)
  _value_witness: (() -> V)
  hash: (K -> Uint64)
  eq: (K -> K -> Bool)
  ->

  type M = (data: Array of List of (K, V), size: Int);

  let new = fn () ->
    M ([] |> array_fill_const 256) 0
  ;;

  let new_sized = fn s ->
    M ([] |> array_fill_const s) 0
  ;;

  let list_contains = fn x l ->
    match l with
    | [] -> false
    | (y,_)::rest -> if (eq x y) then true else (list_contains x rest)
  ;;

  let get_key_idx = fn x d -> hash x |> u64_bit_and ((array_size d) - 1) |> u64_to_int
  ;;

  let list_upsert = fn x v l ->
    match l with
    | [] -> [(x, v)]
    | (k, old)::rest -> (
      if (eq x k) then (
        (x, v)::rest
      )
      else (
        (k, old)::(list_upsert x v rest)
      )
    )
  ;;

  let set = fn x v m ->
  # x : K, v : V,  m : Array of (List of (K, V))
    let key_idx = get_key_idx x m.data;
    let bucket = m.data[key_idx];

    let bucket_contains = bucket |> list_contains x;
    let new_bucket = if bucket_contains then (list_upsert x v bucket) else ((x, v)::bucket);
    m.data[key_idx] := new_bucket;
    M (m.data) ((if bucket_contains then 0 else 1) + m.size)


  ;;

  let list_find = fn x l ->
    match l with
    | [] -> None
    | (y,v)::rest -> if (eq x y) then (Some v) else (list_find x rest)
  ;;

  let get = fn x m ->
    let key_idx = get_key_idx x m.data;
    let node_list = m.data[key_idx];
    node_list |> list_find x
  ;;
;

let test = module () ->
  let IntSet = Set
    (fn x ->
      let xb = x |> asbytes ;
      hash_string xb
    )
    (==)
  ;

  let test_set_1 = (
    let s = IntSet.new () in
    let s2 = IntSet.add 2 s in
    IntSet.contains 2 s && !IntSet.contains 3 s
  );

  let test_set_2 = (
    let s = IntSet.new ()
    |> IntSet.add 2
    |> IntSet.add 3
    |> IntSet.add 4
    |> IntSet.add 5 
    |> IntSet.add 5 
    in
    IntSet.contains 2 s && IntSet.contains 3 s && !IntSet.contains 1 s && s.size == 4
  );


  let IntMap = Map 
    (fn () -> "")
    (fn () -> 0)
    (fn xb: (String) ->
      hash_string xb
    )
    (==)
  ;
  let test_map_1 = (
    let m = IntMap.new () |> IntMap.set "h" 456 |> IntMap.set "hfadf" 783 in
    (IntMap.get "h" m == Some 456)
    && (IntMap.get "hfadf" m == Some 783)
    && (IntMap.get "a" m == None)
    && m.size == 2
  )

;
