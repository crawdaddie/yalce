let beat = 60. / 170.;

let bpl = beat / 4.;
let scale_dur = fn dur: (Int) -> bpl * (Double dur)
;;

let play_param_acc = fn (acc, dur): (Array of Double, Double) x ->
  match x with
  | Pos d -> (acc[0] := d; (acc, dur))
  | Retrig d -> (acc[2] := d / dur; (acc, dur))
  | Dur d -> (acc[3] := d; (acc, dur))
  | Rev d if (d > 0.) -> (acc[4] := -1.; (acc, dur))
  | _ -> (acc, dur)
;;

let play_event = fn dur:(Double) i:(Int) (note, instr, plist): (Int, Int, List of Param) ->
  match instr with
  | 0 -> (
    # print `{note}:{(note - 60.) |> midiratio}\n`;
    let ps, _ = Lists.fold play_param_acc ([|0., 1., 0., 1., 1.|], dur) plist;
    sp 0. (dur * (ps[3])) (ps[0]) (ps[2]) ((note - 60.) |> midiratio) (ps[4]) |> play_node 
    ;
    ()
  )
  | _ -> ()
  # sp play_node;
;;

let play_event_acc = fn (dur, i): (Double, Int) e ->
  play_event dur i e;
  (dur, i - 1)
;;


let x = pat
|> Str.trim_nl
|> cor_lines
|> cor_loop
|> cor_map (fn (dur, line) ->
  let (num, evs) = parse_line line 0 [];

  let _ = Lists.fold play_event_acc (scale_dur dur, num - 1) evs;

  scale_dur dur

  )
|> play_pattern beat

