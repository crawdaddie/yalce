# let (~>) = fn t n -> play_into t n;
let drums = fn () ->

  array_fill_const 28 0.25
  |> iter
  |> cor_map (fn d -> 
    Math.chance 0.2 (fn () ->
      rim (Math.rrand 1500. 1800.) (Math.rrand 0.05 0.5) ~> fx_node ;
    );
    metal_hat (Math.rrand 0.01 0.05) ~> fx_node; 
    d * beat
  )
  |> play_pattern 0.;

  let xx = (fn () ->
    yield 1.;
    metal_snare 0.1 1.5 |> play_fx (random_fx ());
    yield 2.;
    metal_snare 0.1 1. |> play_fx (random_fx ());
    yield 1.;

    yield 1.;
    metal_snare 0.1 2. |> play_fx (random_fx ());
    yield 1.;
    metal_snare 0.1 1. |> play_fx (random_fx ());
    yield 0.75;
    metal_snare 0.1 1. |> play_fx (random_fx ());
    yield 0.75;
    metal_snare 0.1 1. |> play_fx (random_fx ());
    yield 0.5;

  ) in  
  xx () |> cor_map (fn d -> d * beat) |> play_pattern 0.;

  yield (play_kick 0.25) ;
  yield 0.75 * beat;
  # (play_rim2 0.25) ;
  # yield 0.5 * beat ;

  yield play_rim 0.5 ;

  yield play_rim2 0.75 ;
  yield play_kick 0.25 ;
  yield play_rim 0.5 ;

  yield play_rim2 0.5 ;
  yield beat;

  Math.chance 0.5 (fn () -> play_kick 0.25);
  yield 0.75 * beat;
  yield play_kick 0.25 ;

  # yield .25 * beat;
  yield play_rim2 1. ;

  yield .25 * beat;
  Math.chance 0.5 (fn () -> play_kick 0.25);

  yield .25 * beat;
  yield play_glitch3 0.25 ;
  yield play_glitch1 0.25 ;
  yield play_glitch1 0.25 ;
  yield play_glitch1 0.25 ;
  # yield beat;

  yield drums ()
;;
let b = bass 0. 0. 0. |> play_node;

  let play_bass = fn note duration ->
    # bass (midi_freq note) (duration * beat * 0.5) |> play_node ;
    # set_nobass (midi_freq note) (duration * beat * 0.5) |> play_node ;
    set_input_scalar b 1 (midi_freq note);
    set_input_scalar b 2 (duration * beat * 0.5);
    set_input_trig b 0;
    duration * beat
  ;;
let bass_line = fn () ->

  yield play_bass 32. 0.5 ;
  yield play_bass 32. 0.5 ;
  yield play_bass 32. 0.5 ;
  yield beat ;
  yield play_bass 30. 1. ;
  yield play_bass 32. 0.5 ;
  yield play_bass 32. 0.25 ;
  yield play_bass 44. 0.25 ;
  yield play_bass 30. 0.25 ;
  yield play_bass 30. 0.25 ;
  yield play_bass 32. 2.5 ;
  yield play_bass 32. 0.25 ;
  yield play_bass 44. 0.25 ;

  # yield (play_bass 32. 0.5) ;

  yield play_bass 30. 0.5 ;
  yield play_bass 40. 0.5 ;
  yield play_bass 32. 0.5 ;
  yield play_bass 39. 2. ;
  yield play_bass 30. 0.5 ;
  yield play_bass 39. 2. ;
  yield play_bass 40. 0.5 ;
  yield play_bass 40. 0.25 ;
  yield play_bass 40. 0.25 ;
  yield beat;

  let arr = [|39., 40., 32., 30., 35., 42.,|];
  let arr2 = [|12., 24., -12., 0., 0., 36.|];

  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;
  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;
  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;
  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;

  yield 0.5 * beat ;

  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;
  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;
  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;
  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;

  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.5 ;
  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 1. ;

  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;
  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;
  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;
  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;

  yield 0.5 * beat ;

  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;
  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;
  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;
  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.25 ;

  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 0.5 ;
  yield play_bass (Math.array_choose arr + Math.array_choose arr2) 1. ;


  yield bass_line ()
;;
