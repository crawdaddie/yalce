let co = fn v sc ->
  set_input_scalar (v[3]) 0 (Math.array_choose [|53., 51., 58.|] |> midi_freq);
  yield 4. * sc;
  set_input_scalar (v[2]) 0 (Math.array_choose [|53., 51., 61.|] |> midi_freq);
  yield 4. * sc;
  set_input_scalar (v[1]) 0 (Math.array_choose [|39., 36., 30.|] |> midi_freq);
  set_input_scalar (v[2]) 0 (Math.array_choose [|53., 51., 61., 63.,|] |> midi_freq);
  yield 4. * sc;
  yield co v sc
;;


let v = [|
  vocals (32. |> midi_freq) |> play_rv,
  vocals (39. |> midi_freq) |> play_rv,
  vocals (51. |> midi_freq) |> play_rv,
  vocals (53. |> midi_freq) |> play_rv

|];
co v (4 * tempo_mul ()) |> play_pattern beat;

