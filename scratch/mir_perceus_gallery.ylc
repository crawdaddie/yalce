let consume_array = fn xs -> 0;;

let returned_array = fn n ->
  [| n, n + 1 |]
;;

let moved_call_arg = fn n ->
  let xs = [| n, n + 1 |];
  consume_array xs
;;

let duplicated_array = fn n ->
  let xs = [| n, n + 1 |];
  (xs, xs)
;;

let borrowed_array_size = fn n ->
  let xs = [| n, n + 1 |];
  let len = array_size xs;
  (xs, len)
;;

let branch_consume_array = fn flag n ->
  let xs = [| n, n + 1 |];
  if flag then consume_array xs else consume_array xs
;;

let branch_drop_array = fn flag n ->
  let xs = [| n, n + 1 |];
  if flag then consume_array xs else 0
;;

let branch_drop_returned_array = fn flag n ->
  let xs = returned_array n;
  if flag then consume_array xs else 0
;;

let match_unused_heap_result = fn flag n ->
  let m = n + 1;
  let xs = if flag then returned_array n else returned_array m;
  0
;;

let tail_return_array = fn keep n xs ->
  if keep then tail_return_array false n xs else xs
;;

let tail_return_array_entry = fn n ->
  tail_return_array true n (returned_array n)
;;

let apply_int = fn f x ->
  f x
;;

let anonymous_lambda_arg = fn n ->
  apply_int (fn x -> x + 1) n
;;

let capturing_lambda_arg = fn n ->
  let bump = 2;
  apply_int (fn x -> x + bump) n
;;

let consume_list = fn xs -> 0;;

let projected_list = fn n ->
  let xs = [n, n + 1, ];
  let box = [| xs |];
  consume_list (box[0])
;;

let range_loop_borrow_array = fn n ->
  let xs = returned_array n;
  for i = 0 .. 3 in (
    array_size xs
  );
  xs
;;

let range_loop_replace_array_cell = fn n ->
  let cell = [| returned_array n |];
  for i = 0 .. 3 in (
    let xs = returned_array (n + i);
    cell[0] := xs
  );
  cell[0]
;;

range_loop_replace_array_cell 2;
range_loop_borrow_array 2;
tail_return_array_entry 2;
duplicated_array 2;
