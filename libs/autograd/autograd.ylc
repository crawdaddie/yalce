let autograd_proc_graph = extern fn Ptr -> (); 

# let pool_reset = fn () -> ();

type TensorNode = (
  shape: Array of Int,
  data: Array of Double,
  grad: Array of Double,
  forward: (TensorNode -> TensorNode),
  backward: (TensorNode -> TensorNode),
  operands: Array of TensorNode,
  op: Int,
  id: Int
);

let IdCounter = [| 0 |];
let tensor_id = fn () ->
  let tid = IdCounter[0];
  IdCounter[0] := tid + 1;
  tid
;;

# let IdCounter = [| 0 |];
# let tensor_id = fn () ->
#   let tid = IdCounter[0];
#   IdCounter[0] := tid + 1;
#   tid
# ;;


import std/Arrays;
import std/Math;

let tensor_shape = fn node: (TensorNode) -> node.shape;;
let tensor_data = fn node: (TensorNode) -> node.data;;
let tensor_grad = fn node: (TensorNode) -> node.grad;;
let tensor_operands = fn node: (TensorNode) -> node.operands;;
let tensor_forward = fn node: (TensorNode) -> node.forward node;;
let tensor_backward = fn node: (TensorNode) -> node.backward node;;
let tensor_set_data = fn node: (TensorNode) data ->
  TensorNode
      node.shape
      data
      node.grad
      node.forward
      node.backward
      node.operands
      node.op
      node.id
;;



let Tensor = fn shape
                data
                f
                b
                operands ->
  TensorNode
      shape
      data
      (array_fill_const (array_size data) 0.)
      f
      b
      operands
      0
     (tensor_id ())
;;

let TensorOp = fn shape
                data
                f
                b
                operands
                op_type
                ->
  TensorNode
      shape
      data
      (array_fill_const (array_size data) 0.)
      f
      b
      operands
      op_type
      (tensor_id ())
;;

let tensor_forward_leaf = fn self -> self;;
let tensor_backward_leaf = fn self -> self;;


let tensor_accum_grad_pair = fn a b delta ->
  let agrad = tensor_grad a;
  let bgrad = tensor_grad b;
  for i = 0 .. array_size delta in (
    agrad[i] := agrad[i] + delta[i];
    bgrad[i] := bgrad[i] + delta[i]
  );
  a
;;

let tensor_accum_grad_row_broadcast = fn bias target delta ->
  let bgrad = tensor_grad bias;
  let tgrad = tensor_grad target;
  let tshape = tensor_shape target;
  let rows = tshape[0];
  let cols = tshape[1];
  for r = 0 .. rows in (
    for c = 0 .. cols in (
      let idx = (r * cols) + c;
      tgrad[idx] := tgrad[idx] + delta[idx];
      bgrad[c] := bgrad[c] + delta[idx]
    )
  );
  bias
;;

let tensor_zero_grad = fn t ->
  let grad = tensor_grad t;
  for i = 0 .. array_size grad in (
    grad[i] := 0.
  );
  t
;;
#
let tensor_accum_grad = fn t delta ->
  let grad = tensor_grad t;
  for i = 0 .. array_size grad in (
    grad[i] := grad[i] + delta[i]
  );
  t
;;
#
let tensor_accum_grad_scaled = fn t delta scale ->
  let grad = tensor_grad t;
  for i = 0 .. array_size grad in (
    grad[i] := grad[i] + scale * delta[i]
  );
  t
;;
#
#
let tensor = fn shape data ->
  TensorOp shape data tensor_forward_leaf tensor_backward_leaf [| |] 0
;;


let tensor_is_row_bias_for = fn bias target ->
  let bshape = tensor_shape bias;
  let tshape = tensor_shape target;
  if array_size bshape == 2 && array_size tshape == 2 then (
       bshape[0] == 1
    && bshape[1] == tshape[1]
  ) else false
;;
let TensorAdd = module () ->
  let N = 1;

  let tensor_add_row_broadcast_data = fn bias target ->
    let bdata = tensor_data bias;
    let tdata = tensor_data target;
    let tshape = tensor_shape target;
    let rows = tshape[0];
    let cols = tshape[1];
    let out = array_fill_const (rows * cols) 0.;
    for r = 0 .. rows in (
      for c = 0 .. cols in (
        let idx = (r * cols) + c;
        out[idx] := tdata[idx] + bdata[c]
      )
    );
    out
  ;;

  let tensor_add_data = fn a b ->
    if tensor_is_row_bias_for a b then (
      tensor_add_row_broadcast_data a b
    ) else if tensor_is_row_bias_for b a then (
      tensor_add_row_broadcast_data b a
    ) else (
      Arrays.map2 (+) (tensor_data a) (tensor_data b)
    )
  ;;

  let shape = fn a b ->
    if tensor_is_row_bias_for a b then (
      tensor_shape b
    ) else if tensor_is_row_bias_for b a then (
      tensor_shape a
    ) else (
      tensor_shape a
    )
  ;;

  let forward = fn self ->
    match self.operands with
    | [| a, b |] ->
      tensor_set_data self (tensor_add_data a b)
    | _ -> self
  ;;

  let backward = fn self ->
    match self.operands with
    | [| a, b |] -> (
      if tensor_is_row_bias_for a b then (
        tensor_accum_grad_row_broadcast a b (tensor_grad self)
      ) else if tensor_is_row_bias_for b a then (
        tensor_accum_grad_row_broadcast b a (tensor_grad self)
      ) else (
        tensor_accum_grad_pair a b (tensor_grad self)
      );
      self
    )
    | _ -> self
  ;;

  let tensor_add = fn a b ->
    TensorOp (shape a b)
      (tensor_add_data a b)
      forward
      backward
      [| a, b |]
      N
  ;;
;
let TensorSub = module () ->
  let tensor_sub_row_broadcast_data = fn bias target ->
    let bdata = tensor_data bias;
    let tdata = tensor_data target;
    let tshape = tensor_shape target;
    let rows = tshape[0];
    let cols = tshape[1];
    let out = array_fill_const (rows * cols) 0.;
    for r = 0 .. rows in (
      for c = 0 .. cols in (
        let idx = (r * cols) + c;
        out[idx] := tdata[idx] - bdata[c]
      )
    );
    out
  ;;

  let tensor_row_bias_sub_data = fn bias target ->
    let bdata = tensor_data bias;
    let tdata = tensor_data target;
    let tshape = tensor_shape target;
    let rows = tshape[0];
    let cols = tshape[1];
    let out = array_fill_const (rows * cols) 0.;
    for r = 0 .. rows in (
      for c = 0 .. cols in (
        let idx = (r * cols) + c;
        out[idx] := bdata[c] - tdata[idx]
      )
    );
    out
  ;;

  let tensor_sub_shape = fn a b ->
    if tensor_is_row_bias_for b a then (
      tensor_shape a
    ) else if tensor_is_row_bias_for a b then (
      tensor_shape b
    ) else (
      tensor_shape a
    )
  ;;

  let tensor_sub_data = fn a b ->
    if tensor_is_row_bias_for b a then (
      tensor_sub_row_broadcast_data b a
    ) else if tensor_is_row_bias_for a b then (
      tensor_row_bias_sub_data a b
    ) else (
      Arrays.map2 (fn x y -> x - y) (tensor_data a) (tensor_data b)
    )
  ;;

  let tensor_accum_grad_row_sum = fn bias target delta sign ->
    let bgrad = tensor_grad bias;
    let tshape = tensor_shape target;
    let rows = tshape[0];
    let cols = tshape[1];
    for r = 0 .. rows in (
      for c = 0 .. cols in (
        let idx = (r * cols) + c;
        bgrad[c] := bgrad[c] + sign * delta[idx]
      )
    );
    bias
  ;;

  let tensor_forward_sub = fn self ->
    match tensor_operands self with
    | [| a, b |] ->
      tensor_set_data self (tensor_sub_data a b)
    | _ -> self
  ;;
  let tensor_backward_sub = fn self ->
    match tensor_operands self with
    | [| a, b |] -> (
      let grad = tensor_grad self;
      if tensor_is_row_bias_for b a then (
        tensor_accum_grad a grad;
        tensor_accum_grad_row_sum b a grad (-1.)
      ) else if tensor_is_row_bias_for a b then (
        tensor_accum_grad_row_sum a b grad 1.;
        tensor_accum_grad_scaled b grad (-1.)
      ) else (
        tensor_accum_grad a grad;
        tensor_accum_grad_scaled b grad (-1.)
      );
      self
    )
    | _ -> self
  ;;

  let tensor_sub = fn a b ->
    TensorOp (tensor_sub_shape a b)
      (tensor_sub_data a b)
      tensor_forward_sub
      tensor_backward_sub
      [| a, b |]
      2
  ;;
;


let tensor_forward_mul = fn self ->
  match tensor_operands self with
  | [| a, b |] ->
    tensor_set_data self (Arrays.map2 (*) (tensor_data a) (tensor_data b))
  | _ -> self
;;

let tensor_backward_mul = fn self ->
  match tensor_operands self with
  | [| a, b |] -> (
    let grad = tensor_grad self;
    let adata = tensor_data a;
    let bdata = tensor_data b;
    let agrad = tensor_grad a;
    let bgrad = tensor_grad b;
    for i = 0 .. array_size grad in (
      agrad[i] := agrad[i] + grad[i] * bdata[i];
      bgrad[i] := bgrad[i] + grad[i] * adata[i]
    );
    self
  )
  | _ -> self
;;

let tensor_mul = fn a b ->
  TensorOp (tensor_shape a)
    (Arrays.map2 (*) (tensor_data a) (tensor_data b))
    tensor_forward_mul
    tensor_backward_mul
    [| a, b |]
    3
;;

let tensor_forward_sq = fn self ->
  match tensor_operands self with
  | [| a |] ->
    tensor_set_data self (Arrays.map (fn x -> x * x) (tensor_data a))
  | _ -> self
;;

let tensor_backward_sq = fn self ->
  match tensor_operands self with
  | [| a |] -> (
    let grad = tensor_grad self;
    let adata = tensor_data a;
    let agrad = tensor_grad a;
    for i = 0 .. array_size grad in (
      agrad[i] := agrad[i] + 2. * adata[i] * grad[i]
    );
    self
  )
  | _ -> self
;;

let tensor_sq = fn a ->
  TensorOp (tensor_shape a)
    (Arrays.map (fn x -> x * x) (tensor_data a))
    tensor_forward_sq
    tensor_backward_sq
    [| a |]
    4
;;


let tensor_forward_neg = fn self ->
  match tensor_operands self with
  | [| a |] ->
    tensor_set_data self (Arrays.map (fn x -> -1. * x) (tensor_data a))
  | _ -> self
;;

let tensor_backward_neg = fn self ->
  match tensor_operands self with
  | [| a |] -> (
    tensor_accum_grad_scaled a (tensor_grad self) (-1.);
    self
  )
  | _ -> self
;;

let tensor_neg = fn a ->
  TensorOp (tensor_shape a)
    (Arrays.map (fn x -> -1. * x) (tensor_data a))
    tensor_forward_neg
    tensor_backward_neg
    [| a |]
    5
;;

let tensor_div_row_broadcast_data = fn bias target ->
  let bdata = tensor_data bias;
  let tdata = tensor_data target;
  let tshape = tensor_shape target;
  let rows = tshape[0];
  let cols = tshape[1];
  let out = array_fill_const (rows * cols) 0.;
  for r = 0 .. rows in (
    for c = 0 .. cols in (
      let idx = (r * cols) + c;
      out[idx] := tdata[idx] / bdata[c]
    )
  );
  out
;;

let tensor_row_bias_div_data = fn bias target ->
  let bdata = tensor_data bias;
  let tdata = tensor_data target;
  let tshape = tensor_shape target;
  let rows = tshape[0];
  let cols = tshape[1];
  let out = array_fill_const (rows * cols) 0.;
  for r = 0 .. rows in (
    for c = 0 .. cols in (
      let idx = (r * cols) + c;
      out[idx] := bdata[c] / tdata[idx]
    )
  );
  out
;;

let tensor_div_shape = fn a b ->
  if tensor_is_row_bias_for b a then (
    tensor_shape a
  ) else if tensor_is_row_bias_for a b then (
    tensor_shape b
  ) else (
    tensor_shape a
  )
;;

let tensor_div_data = fn a b ->
  if tensor_is_row_bias_for b a then (
    tensor_div_row_broadcast_data b a
  ) else if tensor_is_row_bias_for a b then (
    tensor_row_bias_div_data a b
  ) else (
    Arrays.map2 (/) (tensor_data a) (tensor_data b)
  )
;;

let tensor_forward_div = fn self ->
  match tensor_operands self with
  | [| a, b |] ->
    tensor_set_data self (tensor_div_data a b)
  | _ -> self
;;

let tensor_accum_grad_row_div = fn bias target delta scale ->
  let bgrad = tensor_grad bias;
  let tshape = tensor_shape target;
  let rows = tshape[0];
  let cols = tshape[1];
  for r = 0 .. rows in (
    for c = 0 .. cols in (
      let idx = (r * cols) + c;
      bgrad[c] := bgrad[c] + scale * delta[idx]
    )
  );
  bias
;;

let tensor_backward_div = fn self ->
  match tensor_operands self with
  | [| a, b |] -> (
    let grad = tensor_grad self;
    if tensor_is_row_bias_for b a then (
      # a / bias : a is [R,C], b is [1,C]
      let bdata = tensor_data b;
      let agrad = tensor_grad a;
      let bgrad = tensor_grad b;
      let tshape = tensor_shape a;
      let rows = tshape[0];
      let cols = tshape[1];
      for r = 0 .. rows in (
        for c = 0 .. cols in (
          let idx = (r * cols) + c;
          agrad[idx] := agrad[idx] + grad[idx] / bdata[c];
          bgrad[c] := bgrad[c] - grad[idx] * (tensor_data a)[idx] / (bdata[c] * bdata[c])
        )
      )
    ) else if tensor_is_row_bias_for a b then (
      # bias / b : a is [1,C], b is [R,C]
      let adata = tensor_data a;
      let bdata = tensor_data b;
      let agrad = tensor_grad a;
      let bgrad = tensor_grad b;
      let tshape = tensor_shape b;
      let rows = tshape[0];
      let cols = tshape[1];
      for r = 0 .. rows in (
        for c = 0 .. cols in (
          let idx = (r * cols) + c;
          agrad[c] := agrad[c] + grad[idx] / bdata[idx];
          bgrad[idx] := bgrad[idx] - grad[idx] * adata[c] / (bdata[idx] * bdata[idx])
        )
      )
    ) else (
      let adata = tensor_data a;
      let bdata = tensor_data b;
      let agrad = tensor_grad a;
      let bgrad = tensor_grad b;
      for i = 0 .. array_size grad in (
        agrad[i] := agrad[i] + grad[i] / bdata[i];
        bgrad[i] := bgrad[i] - grad[i] * adata[i] / (bdata[i] * bdata[i])
      )
    );
    self
  )
  | _ -> self
;;

let tensor_div = fn a b ->
  TensorOp (tensor_div_shape a b)
    (tensor_div_data a b)
    tensor_forward_div
    tensor_backward_div
    [| a, b |]
    6
;;

let tensor_forward_exp = fn self ->
  match tensor_operands self with
  | [| a |] ->
    tensor_set_data self (Arrays.map Math.exp (tensor_data a))
  | _ -> self
;;

let tensor_backward_exp = fn self ->
  match tensor_operands self with
  | [| a |] -> (
    let grad = tensor_grad self;
    let odata = tensor_data self;
    let agrad = tensor_grad a;
    for i = 0 .. array_size grad in (
      agrad[i] := agrad[i] + grad[i] * odata[i]
    );
    self
  )
  | _ -> self
;;

let tensor_exp = fn a ->
  TensorOp (tensor_shape a)
    (Arrays.map Math.exp (tensor_data a))
    tensor_forward_exp
    tensor_backward_exp
    [| a |]
    10
;;

let tensor_forward_log = fn self ->
  match tensor_operands self with
  | [| a |] ->
    tensor_set_data self (Arrays.map Math.log (tensor_data a))
  | _ -> self
;;

let tensor_backward_log = fn self ->
  match tensor_operands self with
  | [| a |] -> (
    let grad = tensor_grad self;
    let adata = tensor_data a;
    let agrad = tensor_grad a;
    for i = 0 .. array_size grad in (
      agrad[i] := agrad[i] + grad[i] / adata[i]
    );
    self
  )
  | _ -> self
;;

let tensor_log = fn a ->
  TensorOp (tensor_shape a)
    (Arrays.map Math.log (tensor_data a))
    tensor_forward_log
    tensor_backward_log
    [| a |]
    11
;;

let tensor_forward_relu = fn self ->
  match tensor_operands self with
  | [| a |] ->
    tensor_set_data self (Arrays.map (Math.max 0.) (tensor_data a))
  | _ -> self
;;

let tensor_backward_relu = fn self ->
  match tensor_operands self with
  | [| a |] -> (
    let grad = tensor_grad self;
    let adata = tensor_data a;
    let agrad = tensor_grad a;
    for i = 0 .. array_size grad in (
      let mask = if adata[i] > 0. then 1. else 0.;
      agrad[i] := agrad[i] + grad[i] * mask
    );
    self
  )
  | _ -> self
;;

let tensor_relu = fn a ->
  TensorOp (tensor_shape a)
    (Arrays.map (Math.max 0.) (tensor_data a))
    tensor_forward_relu
    tensor_backward_relu
    [| a |]
    7
;;

let tensor_forward_sum = fn self ->
  match tensor_operands self with
  | [| a |] -> (
    let data = tensor_data a;
    let acc = [| 0. |];
    for i = 0 .. array_size data in (
      acc[0] := acc[0] + data[i]
    );
    tensor_set_data self [| acc[0] |]
  )
  | _ -> self
;;

let tensor_backward_sum = fn self ->
  match tensor_operands self with
  | [| a |] -> (
    let grad = tensor_grad self;
    let agrad = tensor_grad a;
    for i = 0 .. array_size agrad in (
      agrad[i] := agrad[i] + grad[0]
    );
    self
  )
  | _ -> self
;;

let tensor_sum = fn a ->
  let data = tensor_data a;
  let acc = [| 0. |];
  for i = 0 .. array_size data in (
    acc[0] := acc[0] + data[i]
  );
  TensorOp [| 1 |] [| acc[0] |] tensor_forward_sum tensor_backward_sum [| a |] 8
;;

# ---- Per-row sum: [B, C] -> [B, 1] ----
# Sums each row (along columns), keeping the batch dimension.
# Forward: out[r] = sum_j a[r, j]
# Backward: a_grad[r, j] += out_grad[r]  (broadcast the row sum back)
let tensor_forward_sum_rows = fn self ->
  match tensor_operands self with
  | [| a |] -> (
    let adata = tensor_data a;
    let ashape = tensor_shape a;
    let rows = ashape[0];
    let cols = ashape[1];
    let out = tensor_data self;
    for r = 0 .. rows in (
      let acc = [| 0. |] in (
        for c = 0 .. cols in (acc[0] := acc[0] + adata[(r * cols) + c]);
        out[r] := acc[0]
      )
    );
    self
  )
  | _ -> self
;;

let tensor_backward_sum_rows = fn self ->
  match tensor_operands self with
  | [| a |] -> (
    let ashape = tensor_shape a;
    let rows = ashape[0];
    let cols = ashape[1];
    let grad = tensor_grad self;
    let agrad = tensor_grad a;
    for r = 0 .. rows in (
      let g = grad[r] in
      for c = 0 .. cols in (
        agrad[(r * cols) + c] := agrad[(r * cols) + c] + g
      )
    );
    self
  )
  | _ -> self
;;

let tensor_sum_rows = fn a ->
  let ashape = tensor_shape a;
  let rows = ashape[0];
  let cols = ashape[1];
  let out = array_fill_const rows 0.;
  for r = 0 .. rows in (
    let adata = tensor_data a in
    let acc = [| 0. |] in (
      for c = 0 .. cols in (acc[0] := acc[0] + adata[(r * cols) + c]);
      out[r] := acc[0]
    )
  );
  TensorOp [| rows, 1 |] out tensor_forward_sum_rows tensor_backward_sum_rows [| a |] 12
;;

# ---- Argmax (no grad, evaluation only) ----
let tensor_argmax = fn a ->
  let adata = tensor_data a;
  let ashape = tensor_shape a;
  let rows = ashape[0];
  let cols = ashape[1];
  let out = array_fill_const rows 0 in (
    for r = 0 .. rows in (
      let best = [| 0 |] in
      let best_val = [| (adata[(r * cols)]) |] in (
        for c = 1 .. cols in (
          let v = adata[(r * cols) + c] in (
            if v > (best_val[0]) then (best[0] := c; best_val[0] := v)
          )
        );
        out[r] := best[0]
      )
    );
    out
  )
;;

# ---- Softmax with numerical stability (subtract max per row) ----
# softmax(a)[r, c] = exp(a[r,c] - max_r) / sum_c exp(a[r,c] - max_r)
let softmax = fn a ->
  let ashape = tensor_shape a in
  let rows = ashape[0] in
  let cols = ashape[1] in
  let adata = tensor_data a in
  let max_vals = array_fill_const rows 0. in (
    for r = 0 .. rows in (
      let mv = [| adata[(r * cols)] |] in (
        for c = 1 .. cols in (
          let v = adata[(r * cols) + c] in (
            if v > mv[0] then mv[0] := v
          )
        );
        max_vals[r] := mv[0]
      )
    );
    let shifted = array_fill_const (rows * cols) 0. in (
      for r = 0 .. rows in (
        for c = 0 .. cols in (
          shifted[(r * cols) + c] := adata[(r * cols) + c] - max_vals[r]
        )
      );
      let exp_shifted = tensor_exp (tensor [| rows, cols |] shifted) in
      let row_sums = tensor_sum_rows exp_shifted in
      let es_data = tensor_data exp_shifted in
      let rs_data = tensor_data row_sums in
      let out = array_fill_const (rows * cols) 0. in (
        for r = 0 .. rows in (
          for c = 0 .. cols in (
            out[(r * cols) + c] := es_data[(r * cols) + c] / rs_data[r]
          )
        );
        tensor [| rows, cols |] out
      )
    )
  )
;;

let tensor_matmul_data = fn a b ->
  let ashape = tensor_shape a;
  let bshape = tensor_shape b;
  let adata = tensor_data a;
  let bdata = tensor_data b;
  let rows = ashape[0];
  let inner = ashape[1];
  let cols = bshape[1];
  let out = array_fill_const (rows * cols) 0.;

  for r = 0 .. rows in (
    for c = 0 .. cols in (
      let acc = [| 0. |];
      for k = 0 .. inner in (
        acc[0] := acc[0] + adata[(r * inner) + k] * bdata[(k * cols) + c]
      );
      out[(r * cols) + c] := acc[0]
    )
  );

  out
;;

let tensor_forward_matmul = fn self ->
  match tensor_operands self with
  | [| a, b |] -> tensor_set_data self (tensor_matmul_data a b)
  | _ -> self
;;

let tensor_backward_matmul = fn self ->
  match tensor_operands self with
  | [| a, b |] -> (
    let ashape = tensor_shape a;
    let bshape = tensor_shape b;
    let adata = tensor_data a;
    let bdata = tensor_data b;
    let grad = tensor_grad self;
    let agrad = tensor_grad a;
    let bgrad = tensor_grad b;
    let rows = ashape[0];
    let inner = ashape[1];
    let cols = bshape[1];

    for r = 0 .. rows in (
      for k = 0 .. inner in (
        let acc = [| 0. |];
        for c = 0 .. cols in (
          acc[0] := acc[0] + grad[(r * cols) + c] * bdata[(k * cols) + c]
        );
        agrad[(r * inner) + k] := agrad[(r * inner) + k] + acc[0]
      )
    );

    for k = 0 .. inner in (
      for c = 0 .. cols in (
        let acc = [| 0. |];
        for r = 0 .. rows in (
          acc[0] := acc[0] + adata[(r * inner) + k] * grad[(r * cols) + c]
        );
        bgrad[(k * cols) + c] := bgrad[(k * cols) + c] + acc[0]
      )
    );
    self
  )
  | _ -> self
;;

let tensor_matmul = fn a b ->
  let ashape = tensor_shape a;
  let bshape = tensor_shape b;
  TensorOp [| ashape[0], bshape[1] |]
    (tensor_matmul_data a b)
    tensor_forward_matmul
    tensor_backward_matmul
    [| a, b |]
    9
;;

let tensor_forward_tree = fn t ->
  match tensor_operands t with
  | [| |] -> tensor_forward t
  | [| a |] -> (
    tensor_forward_tree a;
    tensor_forward t
  )
  | [| a, b |] -> (
    tensor_forward_tree a;
    tensor_forward_tree b;
    tensor_forward t
  )
  | _ -> tensor_forward t
;;

let tensor_backward_tree = fn t ->
  tensor_backward t;
  match tensor_operands t with
  | [| |] -> t
  | [| a |] -> (
    tensor_backward_tree a;
    t
  )
  | [| a, b |] -> (
    tensor_backward_tree a;
    tensor_backward_tree b;
    t
  )
  | _ -> t
;;

let tensor_seed_loss = fn loss ->
  let grad = tensor_grad loss;
  grad[0] := 1.
;;

let tensor_backward_loss = fn loss ->
  tensor_seed_loss loss;
  tensor_backward_tree loss
;;

let tensor_sgd_step = fn learning_rate t ->
  let data = tensor_data t;
  let grad = tensor_grad t;
  for i = 0 .. array_size data in (
    data[i] := data[i] - learning_rate * grad[i]
  );
  t
;;


let linear = fn w b x ->
  tensor_matmul x w |> TensorAdd.tensor_add b
;;

let random_array = fn n scale ->
  let x = array_fill_const n 0.;
  for i = 0 .. n in (
    x[i] := scale * Math.rrand -1. 1. 
  );
  x
;;

let tensor_rand = fn shape scale ->
  let size = shape[0] * shape[1];
  tensor shape (random_array size scale)
;;

let tensor_zeroes = fn shape ->
  let size = shape[0] * shape[1];
  tensor shape (array_fill_const size 0.)
;;

let tensor_ones = fn shape ->
  let size = shape[0] * shape[1];
  tensor shape (array_fill_const size 1.)
;;

# ---- He / Xavier initialization ----
# He init: scale = sqrt(2 / fan_in) — good for ReLU layers
# Xavier init: scale = sqrt(1 / fan_in) — good for sigmoid/tanh
let tensor_he_init = fn shape ->
  let fan_in = shape[0];
  let scale = Math.sqrt (2. / (Double fan_in));
  let size = shape[0] * shape[1];
  let data = array_fill_const size 0.;
  for i = 0 .. size in (data[i] := scale * (Math.rrand -1. 1.));
  tensor shape data
;;

let tensor_xavier_init = fn shape ->
  let fan_in = shape[0];
  let scale = Math.sqrt (1. / (Double fan_in));
  let size = shape[0] * shape[1];
  let data = array_fill_const size 0.;
  for i = 0 .. size in (data[i] := scale * (Math.rrand -1. 1.));
  tensor shape data
;;

# ---- Adam optimizer (flat buffer approach) ----
# All m and v moments stored in a single flat Double array each.
# Offsets computed at creation. adam_step indexes into the flat buffers.

let sum_sizes = fn params i ->
  if i >= array_size params then 0
  else array_size (tensor_data (params[i])) + sum_sizes params (i + 1)
;;

# Compute prefix offsets: offset[i] = sum of sizes[0..i]
let adam_offsets = fn params ->
  let n = array_size params in
  let offsets = array_fill_const (n + 1) 0 in
  let acc = [| 0 |] in (
    for i = 0 .. n in (
      offsets[i] := acc[0];
      acc[0] := acc[0] + array_size (tensor_data (params[i]))
    );
    offsets[n] := acc[0];
    offsets
  )
;;

# Create flat m/v buffers (one big array each)
let adam_create_m = fn params ->
  array_fill_const (sum_sizes params 0) 0.
;;

let adam_create_v = fn params ->
  array_fill_const (sum_sizes params 0) 0.
;;

let adam_create_t = fn params ->
  array_fill_const (array_size params) 0
;;

# Adam step: updates params in place using flat m/v buffers + offsets
let adam_step = fn params m_buf v_buf t_arr offsets lr l2 ->
  let b1 = 0.9 in
  let b2 = 0.999 in
  let eps = 0.00000001 in (
    for i = 0 .. array_size params in (
      let p = params[i] in
      let data = tensor_data p in
      let grad = tensor_grad p in
      let off = offsets[i] in
      let size = array_size data in (
        t_arr[i] := t_arr[i] + 1;
        let t = t_arr[i] in
        let b1t = Math.pow b1 (Double t) in
        let b2t = Math.pow b2 (Double t) in (
          for j = 0 .. size in (
            let g = grad[j] + l2 * data[j] in
            let m_old = m_buf[off + j] in
            let v_old = v_buf[off + j] in
            let m_new = b1 * m_old + (1. - b1) * g in
            let v_new = b2 * v_old + (1. - b2) * g * g in
            let m_hat = m_new / (1. - b1t) in
            let v_hat = v_new / (1. - b2t) in (
              m_buf[off + j] := m_new;
              v_buf[off + j] := v_new;
              data[j] := data[j] - lr * m_hat / (Math.sqrt v_hat + eps)
            )
          )
        )
      )
    )
  )
;;

let squared_error = fn pred target ->
  let err = TensorSub.tensor_sub pred target;
  tensor_sum (tensor_sq err)
;;

let linspace_array = fn start stop n ->
  if n <= 0 then (
    [| |]
  ) else if n == 1 then (
    [| start |]
  ) else (
    let xs = array_fill_const n 0.;
    let denom = Double (n - 1);
    for i = 0 .. n in (
      xs[i] := start + (stop - start) * (Double i) / denom
    );
    xs
  )
;;

let op_name = fn op ->
  match op with
  | 0 -> "Leaf"
  | 1 -> "Add"
  | 2 -> "Sub"
  | 3 -> "Mul"
  | 4 -> "Sq"
  | 5 -> "Neg"
  | 6 -> "Div"
  | 7 -> "Relu"
  | 8 -> "Sum"
  | 9 -> "Matmul"
  | 10 -> "Exp"
  | 11 -> "Log"
  | _ -> "Unknown"
;;

let test = module () ->

  let make_a = fn () ->
    tensor [| 2, 2 |] [| 1., 2., 3., 4. |]
  ;;

  let make_b = fn () ->
    tensor [| 2, 2 |] [| 10., 20., 30., 40. |]
  ;;

  let shape1_eq = fn xs x0 ->
       array_size xs == 1
    && xs[0] == x0
  ;;

  let shape2_eq = fn xs x0 x1 ->
       array_size xs == 2
    && xs[0] == x0
    && xs[1] == x1
  ;;

  let vec1_eq = fn xs x0 ->
       array_size xs == 1
    && xs[0] == x0
  ;;

  let vec2_eq = fn xs x0 x1 ->
       array_size xs == 2
    && xs[0] == x0
    && xs[1] == x1
  ;;

  let vec3_eq = fn xs x0 x1 x2 ->
       array_size xs == 3
    && xs[0] == x0
    && xs[1] == x1
    && xs[2] == x2
  ;;

  let vec4_eq = fn xs x0 x1 x2 x3 ->
       array_size xs == 4
    && xs[0] == x0
    && xs[1] == x1
    && xs[2] == x2
    && xs[3] == x3
  ;;

  let vec6_eq = fn xs x0 x1 x2 x3 x4 x5 ->
       array_size xs == 6
    && xs[0] == x0
    && xs[1] == x1
    && xs[2] == x2
    && xs[3] == x3
    && xs[4] == x4
    && xs[5] == x5
  ;;

  let operand_count1 = fn t ->
    match tensor_operands t with
    | [| _ |] -> true
    | _ -> false
  ;;

  let operand_count2 = fn t ->
    match tensor_operands t with
    | [| _, _ |] -> true
    | _ -> false
  ;;

  let test_tensor_constructor = fn () ->
    let a = make_a ();
    let shape = tensor_shape a;
    let data = tensor_data a;
    let grad = tensor_grad a;
       array_size (tensor_operands a) == 0
    && shape2_eq shape 2 2
    && vec4_eq data 1. 2. 3. 4.
    && vec4_eq grad 0. 0. 0. 0.
  ;;

  let test_tensor_add = fn () ->
    let c = TensorAdd.tensor_add (make_a ()) (make_b ());
       shape2_eq (tensor_shape c) 2 2
    && vec4_eq (tensor_data c) 11. 22. 33. 44.
    && operand_count2 c
  ;;

  let test_tensor_add_bias_broadcast = fn () ->
    let x = tensor [| 2, 3 |] [| 1., 2., 3., 4., 5., 6. |];
    let bias = tensor [| 1, 3 |] [| 10., 20., 30. |];
    let c = TensorAdd.tensor_add x bias;
       shape2_eq (tensor_shape c) 2 3
    && vec6_eq (tensor_data c) 11. 22. 33. 14. 25. 36.
    && operand_count2 c
  ;;

  let test_tensor_add_bias_broadcast_left = fn () ->
    let x = tensor [| 2, 3 |] [| 1., 2., 3., 4., 5., 6. |];
    let bias = tensor [| 1, 3 |] [| 10., 20., 30. |];
    let c = TensorAdd.tensor_add bias x;
       shape2_eq (tensor_shape c) 2 3
    && vec6_eq (tensor_data c) 11. 22. 33. 14. 25. 36.
    && operand_count2 c
  ;;

  let test_tensor_sub = fn () ->
    let c = TensorSub.tensor_sub (make_b ()) (make_a ());
       shape2_eq (tensor_shape c) 2 2
    && vec4_eq (tensor_data c) 9. 18. 27. 36.
    && operand_count2 c
  ;;

  let test_tensor_sub_bias_broadcast = fn () ->
    let x = tensor [| 2, 3 |] [| 1., 2., 3., 4., 5., 6. |];
    let bias = tensor [| 1, 3 |] [| 10., 20., 30. |];
    let c = TensorSub.tensor_sub x bias;
       shape2_eq (tensor_shape c) 2 3
    && vec6_eq (tensor_data c) (-9.) (-18.) (-27.) (-6.) (-15.) (-24.)
    && operand_count2 c
  ;;

  let test_tensor_sub_bias_broadcast_left = fn () ->
    let x = tensor [| 2, 3 |] [| 1., 2., 3., 4., 5., 6. |];
    let bias = tensor [| 1, 3 |] [| 10., 20., 30. |];
    let c = TensorSub.tensor_sub bias x;
       shape2_eq (tensor_shape c) 2 3
    && vec6_eq (tensor_data c) 9. 18. 27. 6. 15. 24.
    && operand_count2 c
  ;;

  let test_backward_sub_bias_broadcast = fn () ->
    let x = tensor [| 2, 3 |] [| 1., 2., 3., 4., 5., 6. |];
    let bias = tensor [| 1, 3 |] [| 10., 20., 30. |];
    let y = TensorSub.tensor_sub x bias;
    let loss = tensor_sum y;
    tensor_seed_loss loss;
    tensor_backward loss;
    tensor_backward y;
       vec6_eq (tensor_grad x) 1. 1. 1. 1. 1. 1.
    && vec3_eq (tensor_grad bias) (-2.) (-2.) (-2.)
  ;;

  let test_backward_sub_bias_broadcast_left = fn () ->
    let x = tensor [| 2, 3 |] [| 1., 2., 3., 4., 5., 6. |];
    let bias = tensor [| 1, 3 |] [| 10., 20., 30. |];
    let y = TensorSub.tensor_sub bias x;
    let loss = tensor_sum y;
    tensor_seed_loss loss;
    tensor_backward loss;
    tensor_backward y;
       vec6_eq (tensor_grad x) (-1.) (-1.) (-1.) (-1.) (-1.) (-1.)
    && vec3_eq (tensor_grad bias) 2. 2. 2.
  ;;


  let test_tensor_mul = fn () ->
    let c = tensor_mul (make_a ()) (make_b ());
       shape2_eq (tensor_shape c) 2 2
    && vec4_eq (tensor_data c) 10. 40. 90. 160.
    && operand_count2 c
  ;;

  let test_tensor_sq = fn () ->
    let c = tensor_sq (make_a ());
       shape2_eq (tensor_shape c) 2 2
    && vec4_eq (tensor_data c) 1. 4. 9. 16.
    && operand_count1 c
  ;;

  let test_tensor_neg = fn () ->
    let c = tensor_neg (make_a ());
       shape2_eq (tensor_shape c) 2 2
    && vec4_eq (tensor_data c) -1. -2. -3. -4.
    && operand_count1 c
  ;;

  let test_tensor_div = fn () ->
    let c = tensor_div (make_b ()) (make_a ());
       shape2_eq (tensor_shape c) 2 2
    && vec4_eq (tensor_data c) 10. 10. 10. 10.
    && operand_count2 c
  ;;

  let test_tensor_div_bias_broadcast = fn () ->
    let x = tensor [| 2, 3 |] [| 10., 20., 30., 40., 50., 60. |];
    let bias = tensor [| 1, 3 |] [| 2., 5., 6. |];
    let c = tensor_div x bias;
       shape2_eq (tensor_shape c) 2 3
    && vec6_eq (tensor_data c) 5. 4. 5. 20. 10. 10.
    && operand_count2 c
  ;;

  let test_tensor_div_bias_broadcast_left = fn () ->
    let x = tensor [| 2, 3 |] [| 1., 2., 3., 4., 5., 6. |];
    let bias = tensor [| 1, 3 |] [| 60., 50., 30. |];
    let c = tensor_div bias x;
       shape2_eq (tensor_shape c) 2 3
    && vec6_eq (tensor_data c) 60. 25. 10. 15. 10. 5.
    && operand_count2 c
  ;;

  let test_backward_div_bias_broadcast = fn () ->
    # x [R,C] / bias [1,C], loss = sum
    # out[r,c] = x[r,c]/b[c]; d/dx = 1/b ; d/db = sum_r -x[r,c]/b[c]^2
    let x = tensor [| 2, 3 |] [| 2., 4., 8., 6., 8., 16. |];
    let bias = tensor [| 1, 3 |] [| 2., 4., 8. |];
    let y = tensor_div x bias;
    let loss = tensor_sum y;
    tensor_seed_loss loss;
    tensor_backward loss;
    tensor_backward y;
    # out = [1,1,1, 3,2,2]
    # x grad = 1/b = [0.5,0.25,0.125] both rows
    # bias grad = -(2+6)/4, -(4+8)/16, -(8+16)/64 = -2, -0.75, -0.375
       vec6_eq (tensor_grad x) 0.5 0.25 0.125 0.5 0.25 0.125
    && vec3_eq (tensor_grad bias) (-2.) (-0.75) (-0.375)
  ;;

  let test_backward_div_bias_broadcast_left = fn () ->
    # bias [1,C] / x [R,C], loss = sum
    # out[r,c] = b[c]/x[r,c]; d/db = sum_r 1/x ; d/dx = -b/x^2
    let x = tensor [| 2, 3 |] [| 1., 2., 4., 2., 4., 8. |];
    let bias = tensor [| 1, 3 |] [| 2., 4., 8. |];
    let y = tensor_div bias x;
    let loss = tensor_sum y;
    tensor_seed_loss loss;
    tensor_backward loss;
    tensor_backward y;
    # out = [2,2,2, 1,1,1]
    # bias grad = (1/1+1/2, 1/2+1/4, 1/4+1/8) = 1.5, 0.75, 0.375
    # x grad = -b/x^2 = -2, -1, -0.5, -0.5, -0.25, -0.125
       vec3_eq (tensor_grad bias) 1.5 0.75 0.375
    && vec6_eq (tensor_grad x) (-2.) (-1.) (-0.5) (-0.5) (-0.25) (-0.125)
  ;;

  let test_tensor_relu = fn () ->
    let c = tensor_relu (tensor [| 1, 4 |] [| -1., 0., 2., 3. |]);
       shape2_eq (tensor_shape c) 1 4
    && vec4_eq (tensor_data c) 0. 0. 2. 3.
    && operand_count1 c
  ;;

  let test_tensor_exp = fn () ->
    let c = tensor_exp (tensor [| 1, 3 |] [| -1., 0., 1. |]);
    let d = tensor_data c;
       shape2_eq (tensor_shape c) 1 3
    && operand_count1 c
    && d[1] == 1.
  ;;

  let test_tensor_log = fn () ->
    let c = tensor_log (tensor [| 1, 3 |] [| 1., 2., Math.exp 1. |]);
    let d = tensor_data c;
       shape2_eq (tensor_shape c) 1 3
    && operand_count1 c
    && d[0] == 0.
    && d[2] == 1.
  ;;

  let test_backward_exp = fn () ->
    # exp(0) = 1; d/dx exp(x) = exp(x) = 1 at x=0
    let a = tensor [| 1, 1 |] [| 0. |];
    let y = tensor_exp a;
    let loss = tensor_sum y;
    tensor_seed_loss loss;
    tensor_backward loss;
    tensor_backward y;
    vec1_eq (tensor_grad a) 1.
  ;;

  let test_backward_log = fn () ->
    # log(2); d/dx log(x) = 1/x = 0.5 at x=2
    let a = tensor [| 1, 1 |] [| 2. |];
    let y = tensor_log a;
    let loss = tensor_sum y;
    tensor_seed_loss loss;
    tensor_backward loss;
    tensor_backward y;
    vec1_eq (tensor_grad a) 0.5
  ;;

  let test_tensor_sum = fn () ->
    let c = tensor_sum (make_a ());
       shape1_eq (tensor_shape c) 1
    && vec1_eq (tensor_data c) 10.
    && operand_count1 c
  ;;

  let test_tensor_matmul = fn () ->
    let a = tensor [| 2, 3 |] [| 1., 2., 3., 4., 5., 6. |];
    let b = tensor [| 3, 2 |] [| 7., 8., 9., 10., 11., 12. |];
    let c = tensor_matmul a b;
       shape2_eq (tensor_shape c) 2 2
    && vec4_eq (tensor_data c) 58. 64. 139. 154.
    && operand_count2 c
  ;;

  let test_forward_tree_refreshes_data = fn () ->
    let a = tensor [| 1, 1 |] [| 2. |];
    let b = tensor [| 1, 1 |] [| 3. |];
    let c = TensorAdd.tensor_add a b;
    tensor_data a[0] := 10.;
    let refreshed = tensor_forward_tree c;
    vec1_eq (tensor_data refreshed) 13.
  ;;

  let test_backward_square = fn () ->
    let a = tensor [| 1, 1 |] [| 3. |];
    let y = tensor_sq a;
    tensor_seed_loss y;
    tensor_backward y;
    vec1_eq (tensor_grad a) 6.
  ;;

  let test_backward_add = fn () ->
    let a = tensor [| 1, 1 |] [| 2. |];
    let b = tensor [| 1, 1 |] [| 3. |];
    let y = TensorAdd.tensor_add a b;
    tensor_seed_loss y;
    tensor_backward y;
       vec1_eq (tensor_grad a) 1.
    && vec1_eq (tensor_grad b) 1.
  ;;

  let test_backward_add_bias_broadcast = fn () ->
    let x = tensor [| 2, 3 |] [| 1., 2., 3., 4., 5., 6. |];
    let bias = tensor [| 1, 3 |] [| 10., 20., 30. |];
    let y = TensorAdd.tensor_add bias x;
    let loss = tensor_sum y;
    tensor_seed_loss loss;
    tensor_backward loss;
    tensor_backward y;
       vec6_eq (tensor_grad x) 1. 1. 1. 1. 1. 1.
    && vec3_eq (tensor_grad bias) 2. 2. 2.
  ;;

  let test_backward_relu_sum = fn () ->
    let a = tensor [| 1, 4 |] [| -1., 0., 2., 3. |];
    let r = tensor_relu a;
    let loss = tensor_sum r;
    tensor_seed_loss loss;
    tensor_backward loss;
    tensor_backward r;
    vec4_eq (tensor_grad a) 0. 0. 1. 1.
  ;;

  let test_backward_matmul_sum = fn () ->
    let a = tensor [| 1, 2 |] [| 2., 3. |];
    let b = tensor [| 2, 1 |] [| 4., 5. |];
    let prod = tensor_matmul a b;
    let loss = tensor_sum prod;
    tensor_seed_loss loss;
    tensor_backward loss;
    tensor_backward prod;
       vec2_eq (tensor_grad a) 4. 5.
    && vec2_eq (tensor_grad b) 2. 3.
  ;;

  let test_backward_tree_sq_sum = fn () ->
    let a = tensor [| 1, 1 |] [| 3. |];
    let loss = tensor_sum (tensor_sq a);
    tensor_seed_loss loss;
    tensor_backward_tree loss;
    vec1_eq (tensor_grad a) 6.
  ;;

  let test_backward_tree_relu_matmul_sum = fn () ->
    let a = tensor [| 1, 2 |] [| 2., 3. |];
    let b = tensor [| 2, 1 |] [| 4., 5. |];
    let prod = tensor_matmul a b;
    let active = tensor_relu prod;
    let loss = tensor_sum active;
    tensor_seed_loss loss;
    tensor_backward_tree loss;
       vec2_eq (tensor_grad a) 4. 5.
    && vec2_eq (tensor_grad b) 2. 3.
  ;;

;
