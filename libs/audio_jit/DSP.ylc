let play_into = extern fn Ptr -> Ptr -> Ptr;
let (~>) = fn n t -> play_into t n;;
let set_input_scalar = extern fn Ptr -> Int -> Double -> Ptr;
let set_input_trig = extern fn Ptr -> Int -> Ptr;
let record_start = extern fn String -> Double -> Int;
let record_stop = extern fn () -> ();

