type SFInfo = (fd: Ptr, frames: Uint64, samplerate: Int, channels: Int);
type SF = (data: Array of Double, channels: Int, samplerate: Int);
type SFB = (data: Array of Double, channels: Int, samplerate: Int);

# A stable registry handle, classified as a resource by the audio compiler.
type BufferRef = Ptr;
let load_sf_buffer = extern fn String -> Int;
let sf_buffer = extern fn Int -> Ptr;
# let load_sf_buffer = fn p ->
#   load_sf_buffer_extern p
# ;;
let sf_open_opt = extern fn String -> Option of SFInfo;
let sf_close = extern fn Ptr -> Int; 
let u64_to_int = extern fn Uint64 -> Int;
let sf_buffer_data = extern fn Ptr -> Array of Double;
let sf_buffer_frames = extern fn Ptr -> Int;
let sf_buffer_channels = extern fn Ptr -> Int;
let sf_buffer_samplerate = extern fn Ptr -> Int;

let sf_read_double = extern fn Ptr -> Ptr -> Uint64 -> Uint64;

let load_sf = fn path ->
  match sf_open_opt path with
    | Some (fd, frames, samplerate, channels) -> (
      let total_size = frames * channels ;
      let data = array_fill_const (u64_to_int total_size) 0.;
      let frames_read = sf_read_double fd (cstr data) total_size;
      sf_close fd;
      SF data channels samplerate
    )
    | None -> SF [| |] 0 0
;;


let load_sf_mono = fn path ->
  match sf_open_opt path with
    | Some (fd, frames, samplerate, channels) -> (
      let total_size = frames * channels ;
      let data = array_fill_const (u64_to_int total_size) 0.;
      let frames_read = sf_read_double fd (cstr data) total_size;
      let frames_int = u64_to_int frames;
      let mono_data = array_fill_const frames_int 0.;
      for i = 0 .. frames_int in (
        mono_data[i] := 0.5 * (data[i * 2 + 0] + data[i * 2 + 1])
      );
      sf_close fd;
      SF mono_data 1 samplerate
    )
    | None -> SF [| |] 0 0
;;

# Registry-owned references outlive every voice that borrows them.
let sf_ref_load = extern fn String -> BufferRef;
let sf_ref_valid = extern fn BufferRef -> Bool;
let load_ref = fn path ->
  let buffer = sf_ref_load path;
  if sf_ref_valid buffer then Some buffer else None
;;

# Fixed mono output; rate is relative to the source sample rate.
let sf_play = extern fn BufferRef -> Double -> Double -> Double -> Double;
open DSP_common;
# let _ = dlopen "./libaudio_jit.so";

# let Audio = extern fn (T: (Double ... -> Double)) -> T;
let play = @Audio fn buffer rate start trigger ->
  sf_play buffer rate start trigger
;;

# Fixed stereo output; mono sources feed both channels.
let sf_play2 = extern fn BufferRef -> Double -> Double -> Double -> Double;
let play2 = @Audio fn buffer rate start trigger ->
  sf_play2 buffer rate start trigger
;;
