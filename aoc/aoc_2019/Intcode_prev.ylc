type VmEvent = 
  | Continue
  | Halted
  | NeedsInput of (Array of Int)
  | Output of Int
  ;

type Vm = (
  pc: Int,
  prog: Array of Int,
  event: VmEvent
);

let get_operand = fn vm offset mode ->
  let pc = vm.pc;
  let rb = vm.rb;
  let arr = vm.prog;

  match mode with
  | 0 -> (
    let a_pos = arr[pc + offset];
    arr[a_pos]
  ) 
  | 1 -> arr[pc + offset]
  | 2 -> (
    let a_pos = rb + arr[pc + offset];
    arr[a_pos]
  )
  | _ -> 0
;;

let write_addr = fn vm offset mode ->
  let pc = vm.pc;
  let rb = vm.rb;
  let arr = vm.prog;
  let pos = arr[pc + offset];

  match mode with
  | 2 -> rb + pos
  | _ -> pos
;;

let pow10 = fn d ->
  match d with
  | 0 -> 1
  | _ -> 10 * pow10 (d - 1)
;;

let get_digit = fn n d ->
  (n / pow10 d) % 10
;;

let add = fn vm ->
  let pc = vm.pc;
  let rb = vm.rb;
  let arr = vm.prog;
  let opcode = arr[pc];
  let pmodes = opcode / 100;

  let a = get_operand vm 1 (get_digit pmodes 0);
  let b = get_operand vm 2 (get_digit pmodes 1);

  let r_pos = write_addr vm 3 (get_digit pmodes 2);
  arr[r_pos] := a + b;

  Vm (pc + 4) rb arr Continue
;;

let mul = fn vm ->
  let pc = vm.pc;
  let rb = vm.rb;
  let arr = vm.prog;
  let opcode = arr[pc];
  let pmodes = opcode / 100;

  let a = get_operand vm 1 (get_digit pmodes 0);
  let b = get_operand vm 2 (get_digit pmodes 1);

  let r_pos = write_addr vm 3 (get_digit pmodes 2);
  arr[r_pos] := a * b;

  Vm (pc + 4) rb arr Continue
;;

let jump_true = fn vm ->
  let pc = vm.pc;
  let rb = vm.rb;
  let arr = vm.prog;
  let opcode = arr[pc];
  let pmodes = opcode / 100;

  let a = get_operand vm 1 (get_digit pmodes 0);
  let b = get_operand vm 2 (get_digit pmodes 1);

  if (a != 0) then (
    Vm b rb arr Continue
  ) else (
    Vm (pc + 3) rb arr Continue
  )
;;

let jump_false = fn vm ->
  let pc = vm.pc;
  let rb = vm.rb;
  let arr = vm.prog;
  let opcode = arr[pc];
  let pmodes = opcode / 100;

  let a = get_operand vm 1 (get_digit pmodes 0);
  let b = get_operand vm 2 (get_digit pmodes 1);

  if (a == 0) then (
    Vm b rb arr Continue
  ) else (
    Vm (pc + 3) rb arr Continue
  )
;;

let lt = fn vm ->
  let pc = vm.pc;
  let rb = vm.rb;
  let arr = vm.prog;
  let opcode = arr[pc];
  let pmodes = opcode / 100;

  let a = get_operand vm 1 (get_digit pmodes 0);
  let b = get_operand vm 2 (get_digit pmodes 1);

  let r_pos = write_addr vm 3 (get_digit pmodes 2);
  arr[r_pos] := if (a < b) then 1 else 0;
 
  Vm (pc + 4) rb arr Continue
;;

let eq = fn vm ->
  let pc = vm.pc;
  let rb = vm.rb;
  let arr = vm.prog;
  let opcode = arr[pc];
  let pmodes = opcode / 100;

  let a = get_operand vm 1 (get_digit pmodes 0);
  let b = get_operand vm 2 (get_digit pmodes 1);

  let r_pos = write_addr vm 3 (get_digit pmodes 2);
  arr[r_pos] := if (a == b) then 1 else 0;
 
  Vm (pc + 4) rb arr Continue
;;

let scanf = extern fn Ptr -> Ptr -> Int;

let get_input = fn vm ->
  let pc = vm.pc;
  let rb = vm.rb;
  let arr = vm.prog;
  let opcode = arr[pc];
  let pmodes = opcode / 100;

  let addr = write_addr vm 1 (get_digit pmodes 0);
  Vm (pc + 2) rb arr (NeedsInput (array_range addr 1 arr))
;;

let output = fn vm ->
  let pc = vm.pc;
  let rb = vm.rb;
  let arr = vm.prog;
  let opcode = arr[pc];
  let pmodes = opcode / 100;

  let v = get_operand vm 1 (get_digit pmodes 0);
  Vm (pc + 2) rb arr (Output v)
;;

let terminate = fn vm ->
  Vm (array_size vm.prog) vm.rb vm.prog Halted
;;

let adjust_rb = fn vm ->
  let pc = vm.pc;
  let rb = vm.rb;
  let arr = vm.prog;
  let opcode = arr[pc];
  let pmodes = opcode / 100;
  let v = get_operand vm 1 (get_digit pmodes 0);

  Vm (pc + 2) (rb + v) arr Continue
;;

let step_vm = fn vm ->
  let pc = vm.pc;
  let arr = vm.prog;

  match arr[pc] % 100 with
  | 1 -> add vm
  | 2 -> mul vm
  | 3 -> get_input vm
  | 4 -> output vm
  | 5 -> jump_true vm
  | 6 -> jump_false vm
  | 7 -> lt vm
  | 8 -> eq vm
  | 9 -> adjust_rb vm
  | 99 -> terminate vm
  | _ -> Vm (pc + 1) vm.rb arr Continue
;;

let copy_prog = fn prog ->
  let cpy = array_fill_const (array_size prog) 0;

  for i = 0 .. array_size prog in (
    cpy[i] := prog[i]
  );
  cpy
;;

let copy_prog_sized = fn prog size ->
  let cpy = array_fill_const size 0;

  for i = 0 .. array_size prog in (
    cpy[i] := prog[i]
  );
  cpy
;;

let run_vm = fn vm ->
  let nvm = step_vm vm;
  match nvm.event with
  | Continue -> run_vm nvm
  | NeedsInput ref -> (
    print "need input for vm\n";
    print "enter an integer: ";
    scanf (cstr "%d") (cstr ref);
    run_vm (Vm nvm.pc nvm.rb nvm.prog Continue)
  )
  | Halted -> nvm
  | Output v -> (
    print `got output value: {v}\n`;
    run_vm (Vm nvm.pc nvm.rb nvm.prog Continue)
  )
;;

let new_vm = fn prog -> Vm 0 0 (copy_prog prog) Continue;;

let Run = fn prog ->
  let v = Vm 0 0 (copy_prog_sized prog 20000) Continue;
  run_vm v
;;
