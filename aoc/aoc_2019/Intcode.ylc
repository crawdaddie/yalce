type VmEvent = 
  | Continue
  | Halted
  | NeedsInput of (Array of Int)
  | Output of Int
  ;

type Vm = (
  pc: Int,
  rb: Int,
  prog: Array of Int,
  event: VmEvent
);

let get_operand = fn pc rb arr offset mode ->
  match mode with
  | 0 -> (
    let a_pos = arr[pc + offset];
    arr[a_pos]
  ) 
  | 1 -> arr[pc + offset]
  | 2 -> (
    let a_pos = rb + arr[pc + offset];
    arr[a_pos]
  )
  | _ -> 0
;;

let write_addr = fn pc rb arr offset mode ->
  let pos = arr[pc + offset];

  match mode with
  | 2 -> rb + pos
  | _ -> pos
;;

let modes = fn pmodes -> 
  let m1 = pmodes % 10;
  let m2 = (pmodes / 10) % 10;
  let m3 = (pmodes / 100) % 10;
  (m1, m2, m3)
;;
let add = fn pc rb arr ->
  let opcode = arr[pc];
  let pmodes = opcode / 100;
  let (m1, m2, m3) = modes pmodes;

  let a = get_operand pc rb arr 1 m1;
  let b = get_operand pc rb arr 2 m2;

  let r_pos = write_addr pc rb arr 3 m3;
  let result = a + b;
  arr[r_pos] := result;

  (pc + 4, rb, Continue)
;;

let mul = fn pc rb arr ->
  let opcode = arr[pc];
  let pmodes = opcode / 100;
  let (m1, m2, m3) = modes pmodes;

  let a = get_operand pc rb arr 1 m1;
  let b = get_operand pc rb arr 2 m2;


  let result = a * b;

  let r_pos = write_addr pc rb arr 3 m3;
  arr[r_pos] := result;


  (pc + 4, rb, Continue)
;;
# Opcode 5 is jump-if-true: if the first parameter is non-zero, it sets the instruction pointer to the value from the second parameter. Otherwise, it does nothing.
# Opcode 6 is jump-if-false: if the first parameter is zero, it sets the instruction pointer to the value from the second parameter. Otherwise, it does nothing.
# Opcode 7 is less than: if the first parameter is less than the second parameter, it stores 1 in the position given by the third parameter. Otherwise, it stores 0.
# Opcode 8 is equals: if the first parameter is equal to the second parameter, it stores 1 in the position given by the third parameter. Otherwise, it stores 0.

let jump_true = fn pc rb arr ->
  let opcode = arr[pc];
  let pmodes = opcode / 100;

  let (m1, m2, _) = modes pmodes;

  let a = get_operand pc rb arr 1 m1;
  let b = get_operand pc rb arr 2 m2;

  if (a != 0) then (
    (b, rb, Continue)
  ) else (
    (pc + 3, rb, Continue)
  )
;;

let jump_false = fn pc rb arr ->
  let opcode = arr[pc];
  let pmodes = opcode / 100;
  let (m1, m2, _) = modes pmodes;

  let a = get_operand pc rb arr 1 m1;
  let b = get_operand pc rb arr 2 m2;

  if (a == 0) then (
    (b, rb, Continue)
  ) else (
    (pc + 3, rb, Continue)
  )
;;

let lt = fn pc rb arr ->
  let opcode = arr[pc];
  let pmodes = opcode / 100;
  let (m1, m2, m3) = modes pmodes;

  let a = get_operand pc rb arr 1 m1;
  let b = get_operand pc rb arr 2 m2;

  let r_pos = write_addr pc rb arr 3 m3;

  arr[r_pos] := if (a < b) then 1 else 0;
 
  (pc + 4, rb, Continue)
;;

let eq = fn pc rb arr ->
  let opcode = arr[pc];
  let pmodes = opcode / 100;

  let (m1, m2, m3) = modes pmodes;


  let a = get_operand pc rb arr 1 m1;
  let b = get_operand pc rb arr 2 m2;

  let r_pos = write_addr pc rb arr 3 m3;


  arr[r_pos] := if (a == b) then 1 else 0;
 
  (pc + 4, rb, Continue)
;;

let scanf = extern fn Ptr -> Ptr -> Int;

let _get_input = fn pc arr -> 

  let opcode = arr[pc];
  # print `3 op: {opcode}\n`;

  let v = [|0|];
  # print "enter an integer: ";
  scanf (cstr "%d") (cstr v);

  let addr = arr[pc + 1];
  arr[addr] := v[0];
  (pc + 2, arr)
  ;;

let _output = fn pc arr -> 
  let opcode = arr[pc];
  let pmodes = opcode / 100;

  let v = arr[pc + 1];
  print `{v}\n`;
  (pc + 2, arr)
  ;;

let get_input = fn pc rb arr ->
  let opcode = arr[pc];
  let pmodes = opcode / 100;
  let m1 = pmodes % 10;
  # print `3 op: {opcode}\n`;

  # let v = [|0|];
  # # print "enter an integer: ";
  # scanf (cstr "%d") (cstr v);

  let addr = write_addr pc rb arr 1 m1;
  # arr[addr] := v[0];
  (pc + 2, rb, NeedsInput (array_range addr 1 arr))
  ;;

let output = fn pc rb arr ->
  let opcode = arr[pc];
  let pmodes = opcode / 100;
  let m1 = pmodes % 10;

  let v = get_operand pc rb arr 1 m1;
  # print `{v}\n`;
  (pc + 2, rb, Output v)
  ;;


let terminate = fn pc rb arr ->
  (array_size arr, rb, Halted)
;;

let adjust_rb = fn pc rb arr ->
  let opcode = arr[pc];
  let pmodes = opcode / 100;
  let m1 = pmodes % 10;
  let v = get_operand pc rb arr 1 m1;
  (pc + 2, rb + v, Continue)
;;

let step_vm = fn vm ->
  let pc = vm.pc;
  let arr = vm.prog;
  let rb = vm.rb;

  let pcn, rbn, ev = match arr[pc] % 100 with
    | 1 -> add pc rb arr
    | 2 -> mul pc rb arr
    | 3 -> get_input pc rb arr
    | 4 -> output pc rb arr
    | 5 -> jump_true pc rb arr
    | 6 -> jump_false pc rb arr
    | 7 -> lt pc rb arr
    | 8 -> eq pc rb arr
    | 9 -> adjust_rb pc rb arr
    | 99 -> terminate pc rb arr
    | _ -> (pc + 1, rb, Continue)
    ;
  Vm pcn rbn arr ev
;;


let copy_prog = fn prog ->
  let cpy = array_fill_const (array_size prog) 0;

  for i = 0 .. array_size prog in (
    cpy[i] := prog[i]
  );
  cpy
;;

let copy_prog_sized = fn prog size ->
  let cpy = array_fill_const size 0;

  for i = 0 .. array_size prog in (
    cpy[i] := prog[i]
  );
  cpy
;;

let run_vm = fn vm ->
  let nvm = step_vm vm;
  match nvm.event with
  | Continue -> run_vm nvm
  | NeedsInput ref -> (
    print "need input for vm\n";
    print "enter an integer: ";
    scanf (cstr "%d") (cstr ref);
    run_vm (Vm nvm.pc nvm.rb nvm.prog Continue)
  )
  | Halted -> nvm
  | Output v -> (
    print `got output value: {v}\n`;
    run_vm (Vm nvm.pc nvm.rb nvm.prog Continue)
  )
;;

let new_vm = fn prog -> Vm 0 0 (copy_prog prog) Continue;;

let Run = fn prog ->
  let v = Vm 0 0 (copy_prog_sized prog 20000) Continue;
  run_vm v
;;

