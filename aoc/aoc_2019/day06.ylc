# print `{orbits[key_idx "C"]}\n`


let empty_int_list = match [0,] with
  | _::rest -> rest
  | [] -> []
  ;

let tree = array_fill_const KEY_CAP empty_int_list;

let cons_tree = fn l tr ->
  match l with
  | [] -> tr
  | x::rest -> (
    match split_on x ')' with
    | None -> tr
    | Some (sun_key, planet_key) -> (
      let planet_key_idx = key_idx planet_key;
      let sun_key_idx = key_idx sun_key;
      let children = tr[sun_key_idx];
      tr[sun_key_idx] := planet_key_idx::children;
      cons_tree rest tr
    )
  )
;;
cons_tree l tree;

let contains_nodes = fn tree nodes target ->
  match nodes with
  | [] -> false
  | idx::rest ->
    if idx == target then true else (
      if contains_nodes tree (tree[idx]) target then true else contains_nodes tree rest target
    )
;;

let depth_nodes = fn tree nodes target d ->
  match nodes with
  | [] -> 0
  | idx::rest ->
    if idx == target then d else (
      let child_depth = depth_nodes tree (tree[idx]) target (d + 1);
      if child_depth > 0 then child_depth else depth_nodes tree rest target d
    )
;;

let depth_from = fn tree idx target d ->
  depth_nodes tree (idx::[]) target d
;;

let common_child = fn tree children a b fallback ->
  match children with
  | [] -> fallback
  | child::rest ->
    if contains_nodes tree (child::[]) a then (
      if contains_nodes tree (child::[]) b then child else common_child tree rest a b fallback
    ) else (
      common_child tree rest a b fallback
    )
;;

let lca_from = fn tree idx a b ->
  let child = common_child tree (tree[idx]) a b idx;
  if child == idx then idx else lca_from tree child a b
;;

let transfers = fn tree from_key to_key ->
  let from = key_idx from_key;
  let dst = key_idx to_key;
  let common = lca_from tree com_idx from dst;

  (depth_from tree common from 0) + (depth_from tree common dst 0) - 2
;;

print `transfers: {transfers tree "YOU" "SAN"}\n`;
