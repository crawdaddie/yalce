let char_to_int = extern fn Char -> Int;

let key_char = fn cc ->
  let c = char_to_int cc;
  let A_int = 'A' |> char_to_int;
  let Z_int = 'Z' |> char_to_int;

  if (c >= A_int && c <= Z_int) then (
    c - A_int
  ) else (
    26 + (c - ('1' |> char_to_int))
  )
;;

let KEY_BASE = 35;
let KEY_CAP = KEY_BASE * KEY_BASE * KEY_BASE;

let key_part = fn key i ->
  if i >= array_size key then 0 else key_char (key[i])
;;

let key_idx = fn key ->
  let a = key_part key 0;
  let b = key_part key 1;
  let c = key_part key 2;

  a * KEY_BASE * KEY_BASE + b * KEY_BASE + c
;;

# type Orbit = (
#   orbit_key: Int
# );
#
let orbits = array_fill_const KEY_CAP 0;

let find_first_idx = fn idx a delim ->
  if idx >= (array_size a) then (None) else (
    match a[idx] with 
    | xx if xx == delim -> Some idx
    | _ -> find_first_idx (idx + 1) a delim 
  )
;;
let split_on = fn str delim ->
  match find_first_idx 0 str delim with
  | Some idx -> Some (str[0 .. idx], str[(idx + 1) ..])
  | None -> None
;;

let proc_orbit_specs = fn l orbits ->
  match l with
  | [] -> orbits
  | x::rest -> (
    match split_on x ')' with
    | None -> orbits
    | Some (sun_key, planet_key) -> (
      let planet_key_idx = key_idx planet_key;
      let sun_key_idx = key_idx sun_key;
      orbits[planet_key_idx] := sun_key_idx;
      proc_orbit_specs rest orbits
    )
  )
;;

proc_orbit_specs l orbits;

let com_idx = key_idx "COM";

let count_orbits = fn orbits c idx ->
  if idx == com_idx then c else (
    let idx2 = orbits[idx];
    count_orbits orbits (c + 1) idx2
  )
;;

let proc_planets = fn orbits ll ->
  match ll with
  | [] -> ()
  | x::rest -> (
    match split_on x ')' with
    | Some (s, p) -> (
      # print "planet: ";
      # print `{p} {key_idx p} orbits (direct / indirect): {count_orbits orbits 0 (key_idx p)}\n`;
      proc_planets orbits rest 
    )
    | None -> ()
  )
;;

let total_orbits = fn orbits ll acc ->
  match ll with
  | [] -> acc
  | x::rest -> (
    match split_on x ')' with
    | Some (s, p) -> total_orbits orbits rest (acc + count_orbits orbits 0 (key_idx p))
    | None -> total_orbits orbits rest acc
  )
;;

proc_planets orbits l;
print `total: {total_orbits orbits l 0}\n`;
