open day13_input;
import Int64code;
open Int64code;

let SCREEN_W = 40;
let SCREEN_H = 25;
let GRID_SIZE = SCREEN_W * SCREEN_H;


type TILE_TYPE =
  | TILE_EMPTY
  | TILE_WALL
  | TILE_BLOCK
  | TILE_PADDLE
  | TILE_BALL
  | TILE_UNKNOWN
  ;

# Intcode tile id -> TILE_TYPE
let tile_of_int = fn n ->
  match n with
  | 0 -> TILE_EMPTY
  | 1 -> TILE_WALL
  | 2 -> TILE_BLOCK
  | 3 -> TILE_PADDLE
  | 4 -> TILE_BALL
  | _ -> TILE_UNKNOWN
;;

let RGBA_BYTES = 4;
let RGBA_EMPTY = [|0x05, 0x07, 0x0a, 0xff|];
let RGBA_WALL = [|0x33, 0x41, 0x55, 0xff|];
let RGBA_BLOCK = [|0x38, 0xbd, 0xf8, 0xff|];
let RGBA_PADDLE = [|0x6e, 0xe7, 0xb7, 0xff|];
let RGBA_BALL = [|0x7d, 0xd3, 0xfc, 0xff|];
let RGBA_UNKNOWN = [|0x64, 0x74, 0x8b, 0xff|];

let tile_rgba = fn tile ->
  match tile with
  | TILE_EMPTY -> RGBA_EMPTY
  | TILE_WALL -> RGBA_WALL
  | TILE_BLOCK -> RGBA_BLOCK
  | TILE_PADDLE -> RGBA_PADDLE
  | TILE_BALL -> RGBA_BALL
  | TILE_UNKNOWN -> RGBA_UNKNOWN
;;


let new_grid = fn () ->
  array_fill_const GRID_SIZE TILE_EMPTY
;;

let grid = new_grid ();
let prog1 = Int64code.copy_prog_sized inp Int64code.MEM_SIZE;

let proc_out = fn b ->
  ()
;;

let run = fn vm out_idx out_buf ->
  let nvm = step_vm vm;
  match nvm.event with
  | Continue -> run nvm out_idx out_buf
  # | Continue -> run nvm
  | Halted -> ()
  | Output v -> (
    if (out_idx == 2) then (
      out_buf[2] := v;
      proc_out out_buf;
      run (Vm nvm.pc nvm.rb nvm.prog Continue) 0 out_buf
    ) else (
      out_buf[out_idx] := v;
      run (Vm nvm.pc nvm.rb nvm.prog Continue) (out_idx + 1) out_buf
    )
  )
;;

run (Int64code.new_vm64 prog1) 0 [|
  Int64code.int64_from_int 0,
  Int64code.int64_from_int 0,
  Int64code.int64_from_int 0
|]


