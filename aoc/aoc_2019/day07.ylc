open day07_input;
import Intcode;
import std/Math;
import std/Permutations;

let run_amp = fn vm inputs output ->
  let nvm = Intcode.step_vm vm;
  match nvm.event with
  | Intcode.NeedsInput ref -> (
    ref[0] := inputs[0];
    run_amp (Intcode.Vm nvm.pc nvm.rb nvm.prog Intcode.Continue) (inputs[1 ..]) output
  )
  | Intcode.Halted -> nvm
  | Intcode.Output v -> (
    output[0] := v;
    Intcode.Vm nvm.pc nvm.rb nvm.prog Intcode.Continue
  )
;;

let phase_sequence = fn prog phases ->
  let vmA = Intcode.new_vm prog;
  let vmB = Intcode.new_vm prog;
  let vmC = Intcode.new_vm prog;
  let vmD = Intcode.new_vm prog;
  let vmE = Intcode.new_vm prog;
  let o = [|0|];

  run_amp vmA [| phases[0], o[0] |] o;
  run_amp vmB [| phases[1], o[0] |] o;
  run_amp vmC [| phases[2], o[0] |] o;
  run_amp vmD [| phases[3], o[0] |] o;
  run_amp vmE [| phases[4], o[0] |] o;
  o[0]
;;

# print `43210: {phase_sequence [|3,15,3,16,1002,16,10,16,1,16,15,15,4,15,99,0,0|] [|4,3,2,1,0|]}\n`;
# print `54321: {phase_sequence [|
# 3,23,3,24,1002,24,10,24,1002,23,-1,23,101,5,23,23,1,24,23,23,4,23,99,0,0|] [|0,1,2,3,4|]}\n`;
# print `65210: {phase_sequence [|3,31,3,32,1002,32,10,32,1001,31,-2,31,1007,31,0,33,1002,33,7,33,1,33,31,31,1,32,31,31,4,31,99,0,0,0   |] [|1,0,4,3,2|]}\n`;

let phases = [|0,1,2,3,4|];
let best = Permutations.fold (fn acc arr ->
  Math.max acc (phase_sequence inp arr)
) 0 phases;

print `{best}\n`;

let run_fb_vms = fn o _a _b _c _d _e ->
  let a = run_amp _a [| o[0] |] o;
  let b = run_amp _b [| o[0] |] o;
  let c = run_amp _c [| o[0] |] o;
  let d = run_amp _d [| o[0] |] o;
  let e = run_amp _e [| o[0] |] o;
  match (a.event, b.event, c.event, d.event, e.event) with
  | (Intcode.Halted, Intcode.Halted, Intcode.Halted, Intcode.Halted, Intcode.Halted) -> o[0]
  | _ -> run_fb_vms o a b c d e
;;

let phase_sequence_fb = fn prog phases ->
  let vmA = Intcode.new_vm prog;
  let vmB = Intcode.new_vm prog;
  let vmC = Intcode.new_vm prog;
  let vmD = Intcode.new_vm prog;
  let vmE = Intcode.new_vm prog;
  let o = [|0|];

  #initialize
  let a = run_amp vmA [| phases[0], o[0] |] o;
  let b = run_amp vmB [| phases[1], o[0] |] o;
  let c = run_amp vmC [| phases[2], o[0] |] o;
  let d = run_amp vmD [| phases[3], o[0] |] o;
  let e = run_amp vmE [| phases[4], o[0] |] o;

  run_fb_vms o a b c d e
;;

print `part2 test1: {phase_sequence_fb [|3,26,1001,26,-4,26,3,27,1002,27,2,27,1,27,26,27,4,27,1001,28,-1,28,1005,28,6,99,0,0,5|] [|9,8,7,6,5|]}\n`;
print `part2 test2: {phase_sequence_fb [|
3,52,1001,52,-5,52,3,53,1,52,56,54,1007,54,5,55,1005,55,26,1001,54,
-5,54,1105,1,12,1,53,54,53,1008,54,0,55,1001,55,1,55,2,53,55,53,4,
53,1001,56,-1,56,1005,56,6,99,0,0,0,0,10
|] [|9,7,8,5,6|]}\n`;

let phases2 = [|5,6,7,8,9|];
let best2 = Permutations.fold (fn acc arr ->
  Math.max acc (phase_sequence_fb inp arr)
) 0 phases2;
print `{best2}\n`;
