open day07_input;
import Intcode;
open Intcode;
# Intcode.Run inp

let run_vm_io = fn vm inputs output ->
  let nvm = step_vm vm;
  match nvm.event with
  | Continue -> run_vm_io nvm inputs output
  | NeedsInput ref -> (
    ref[0] := inputs[0];
    run_vm_io (Vm nvm.pc 0 nvm.prog Continue) (inputs[1 ..]) output
  )
  | Halted -> nvm
  | Output v -> (
    output[0] := v;
    run_vm_io (Vm nvm.pc 0 nvm.prog Continue) inputs output
  )
;;

let phase_sequence = fn prog phases ->
  let vmA = new_vm prog;   
  let vmB = new_vm prog;
  let vmC = new_vm prog;
  let vmD = new_vm prog;
  let vmE = new_vm prog;
  let o = [|0|];

  run_vm_io vmA [| phases[0], 0 |] o;
  run_vm_io vmB [| phases[1], o[0] |] o;
  run_vm_io vmC [| phases[2], o[0] |] o;
  run_vm_io vmD [| phases[3], o[0] |] o;
  run_vm_io vmE [| phases[4], o[0] |] o;
  o[0]
;;

