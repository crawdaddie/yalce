|] [|9,7,8,5,6|]}\n`;

let phases2 = [|5,6,7,8,9|];
let best2 = [|0|];
fold_permutations (fn acc arr ->
  Math.max acc (phase_sequence_fb inp arr)
) best2 (array_size phases2) phases2;
print `{best2[0]}\n`;
