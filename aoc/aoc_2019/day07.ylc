let swap = fn arr i j ->
  let tmp = arr[i];
  arr[i] := arr[j];
  arr[j] := tmp
;;

let print_perm = fn arr ->
  for i = 0 .. array_size arr in (
    print `{arr[i]}`
  );
  print "\n"
;;
import std/Math;
let fold_permutations = fn f acc k arr ->
  if k == 1 then (
    # compute final output and compare with acc ??
    # print_perm arr
    acc[0] := f (acc[0]) arr ;
    # Math.max (acc[0]) (phase_sequence inp arr);
    ()
  ) else (
    fold_permutations f acc (k - 1) arr;
    for i = 0 .. (k - 1) in (
      if k % 2 == 0 then (
        swap arr i (k - 1)
      ) else (
        swap arr 0 (k - 1)
      );

      fold_permutations f acc (k - 1) arr
    )
  )
;;

# let phases = [|0,1,2,3,4|];
let phases = [|0,1,2,3,4|];
let best = [|0|];
fold_permutations (fn acc arr -> 
  Math.max acc (phase_sequence inp arr)
) best (array_size phases) phases;

print `{best[0]}\n`;


let run_vm_io2 = fn vm inputs output ->
  let nvm = step_vm vm;
  match nvm.event with
  | Continue -> run_vm_io2 nvm inputs output
  | NeedsInput ref -> (
    ref[0] := inputs[0];
    run_vm_io2 (Vm nvm.pc 0 nvm.prog Continue) (inputs[1 ..]) output
  )
  | Halted -> nvm
  | Output v -> (
    output[0] := v;
    Vm nvm.pc 0 nvm.prog Continue
  )
;;


let run_fb_vms = fn o _a _b _c _d _e ->
  let a = run_vm_io2 _a [| o[0] |] o;
  let b = run_vm_io2 _b [| o[0] |] o;
  let c = run_vm_io2 _c [| o[0] |] o;
  let d = run_vm_io2 _d [| o[0] |] o;
  let e = run_vm_io2 _e [| o[0] |] o;
  match (a.event, b.event, c.event, d.event, e.event) with 
  | (Halted, Halted, Halted, Halted, Halted) -> o[0]
  | _ -> run_fb_vms o a b c d e
;;

let phase_sequence_fb = fn prog phases ->
  let vmA = new_vm prog;   
  let vmB = new_vm prog;
  let vmC = new_vm prog;
  let vmD = new_vm prog;
  let vmE = new_vm prog;
  let o = [|0|];

  #initialize
  let a = run_vm_io2 vmA [| phases[0], o[0] |] o;
  let b = run_vm_io2 vmB [| phases[1], o[0] |] o;
  let c = run_vm_io2 vmC [| phases[2], o[0] |] o;
  let d = run_vm_io2 vmD [| phases[3], o[0] |] o;
  let e = run_vm_io2 vmE [| phases[4], o[0] |] o;

  run_fb_vms o a b c d e
;;

