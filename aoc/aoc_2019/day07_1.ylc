open day07_input;
import Intcode;
open Intcode;

type AmpResult = (
  pc: Int,
  rb: Int,
  input_used: Int,
  halted: Int,
  output: Int
);

let step_direct = fn pc rb arr ->
  match arr[pc] % 100 with
  | 1 -> add pc rb arr
  | 2 -> mul pc rb arr
  | 3 -> get_input pc rb arr
  | 4 -> output pc rb arr
  | 5 -> jump_true pc rb arr
  | 6 -> jump_false pc rb arr
  | 7 -> lt pc rb arr
  | 8 -> eq pc rb arr
  | 9 -> adjust_rb pc rb arr
  | 99 -> terminate pc rb arr
  | _ -> (pc + 1, rb, Continue)
;;

let run_amp_halt = fn pc rb arr phase signal input_idx last ->
  let pcn, rbn, ev = step_direct pc rb arr;

  match ev with
  | Continue -> run_amp_halt pcn rbn arr phase signal input_idx last
  | NeedsInput ref -> (
    ref[0] := if input_idx == 0 then phase else signal;
    run_amp_halt pcn rbn arr phase signal (input_idx + 1) last
  )
  | Output v -> run_amp_halt pcn rbn arr phase signal input_idx v
  | Halted -> last
;;

let run_amp_once = fn prog phase signal ->
  run_amp_halt 0 0 (copy_prog prog) phase signal 0 0
;;

let phase_sequence = fn prog phases ->
  run_amp_once prog (phases[0]) 0
  |> run_amp_once prog (phases[1])
  |> run_amp_once prog (phases[2])
  |> run_amp_once prog (phases[3])
  |> run_amp_once prog (phases[4])
;;

