let swap = fn arr i j ->
  let tmp = arr[i];
  arr[i] := arr[j];
  arr[j] := tmp
;;

let print_perm = fn arr ->
  for i = 0 .. array_size arr in (
    print `{arr[i]}`
  );
  print "\n"
;;
import std/Math;
let fold_permutations = fn f acc k arr ->
  if k == 1 then (
    # compute final output and compare with acc ??
    # print_perm arr
    acc[0] := f (acc[0]) arr ;
    # Math.max (acc[0]) (phase_sequence inp arr);
    ()
  ) else (
    fold_permutations f acc (k - 1) arr;
    for i = 0 .. (k - 1) in (
      if k % 2 == 0 then (
        swap arr i (k - 1)
      ) else (
        swap arr 0 (k - 1)
      );

      fold_permutations f acc (k - 1) arr
    )
  )
;;

let run_amp_out = fn pc rb prog phase signal input_used ->
  let pcn, rbn, ev = step_direct pc rb prog;

  match ev with
  | Continue -> run_amp_out pcn rbn prog phase signal input_used
  | NeedsInput ref -> (
    ref[0] := if input_used == 0 then phase else signal;
    run_amp_out pcn rbn prog phase signal 1
  )
  | Output v -> AmpResult pcn rbn input_used 0 v
  | Halted -> AmpResult pcn rbn input_used 1 signal
;;

let run_fb_vms = fn last signal phases
                    pcA rbA usedA arrA
                    pcB rbB usedB arrB
                    pcC rbC usedC arrC
                    pcD rbD usedD arrD
                    pcE rbE usedE arrE ->

  let ares = run_amp_out pcA rbA arrA (phases[0]) signal usedA;
  let bres = run_amp_out pcB rbB arrB (phases[1]) ares.output usedB;
  let cres = run_amp_out pcC rbC arrC (phases[2]) bres.output usedC;
  let dres = run_amp_out pcD rbD arrD (phases[3]) cres.output usedD;
  let eres = run_amp_out pcE rbE arrE (phases[4]) dres.output usedE;

  if eres.halted == 1 then last else (
    run_fb_vms eres.output eres.output phases
      ares.pc ares.rb ares.input_used arrA
      bres.pc bres.rb bres.input_used arrB
      cres.pc cres.rb cres.input_used arrC
      dres.pc dres.rb dres.input_used arrD
      eres.pc eres.rb eres.input_used arrE
  )
;;

let phase_sequence_fb = fn prog phases ->
  run_fb_vms 0 0 phases
    0 0 0 (copy_prog prog)
    0 0 0 (copy_prog prog)
    0 0 0 (copy_prog prog)
    0 0 0 (copy_prog prog)
    0 0 0 (copy_prog prog)
;;

# let phases = [|0,1,2,3,4|];
let phases = [|0,1,2,3,4|];
let phases2 = [|5,6,7,8,9|];
let best = [|0|];
let best2 = [|0|];
fold_permutations (fn acc arr -> 
  Math.max acc (phase_sequence inp arr)
) best (array_size phases) phases;

print `{best[0]}\n`;

