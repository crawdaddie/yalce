let Cymbal = module () -> 
  let cyms = @Audio fn dur ->
    let trigger = trig 0;

    let noise =
      white ()
        |> Filter.hpf 10000. 1.
      ;

    let metal = ~[313., 467., 701., 1039.]
      |> sin_osc
      |> (*) (~[0.18, 0.14, 0.10, 0.07])
      |> sum
      |> gaindb 10.
      |> (*) (decay 0.25 trigger)
      |> Filter.hpf 3000. 1.
      ;

    noise + metal
      |> (*) (rect dur trigger |> asr 0. 1. 0.2 |> kill_on_end)

    # metal
    #   |> (*) (rect dur trigger |> asr 0. 1. 0.2 |> kill_on_end)
  ;;

  let defs = [| 0.1 |];
  let node = synth_default defs cyms;
  let play = fn pl -> node pl |> play_node;;
;


let x = fn () ->
  Cymbal.play [("dur", 0.001),];
  yield 0.125;
  yield x ()
;;

x () |> play_pattern 0.
