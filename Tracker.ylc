let update_durs = fn ev row col all_cols phrase_end ->
  match ev with
  | Note (note, instr, plist, _, note_col) -> (
    let next = all_cols[note_col];
    let end = if next < row then phrase_end else next;
    let plist_copy = plist;
    Note (note, instr, plist_copy, end - row, note_col)
  )
  | Group evs -> (
    for i = 0 .. array_size evs in (
      let child = evs[i];
      let next = update_durs child row i all_cols phrase_end;
      evs[i] := next
    );
    Group evs
  )
  | Choice evs -> (
    for i = 0 .. array_size evs in (
      # let child = copy_atom (evs[i]);
      let child = evs[i];
      let next = update_durs child row col all_cols phrase_end;
      evs[i] := next
    );
    Choice evs
  )
  | _ -> ev
;;

let mark_rests = fn ev row col all_cols ->
  match ev with
  | Rest -> (all_cols[col] := row; ())
  | Note (_, _, _, _, note_col) -> (all_cols[note_col] := row; ())
  | Group evs -> (
    for i = 0 .. array_size evs in (
      let child = evs[i];
      mark_rests child row i all_cols
    );
    ()
  )
  | Choice _ -> ()
  | _ -> ()
;;

let compute_column_wise_durs = fn arr ->
  let sz = array_size arr;
  let starts = array_fill_const sz 0;
  let clock = [| 0 |];

  for i = 0 .. sz in (
    let dur, _ = arr[i];
    starts[i] := clock[0];
    clock[0] := clock[0] + dur
  );

  let all_cols = array_fill_const 32 clock[0];

  for _i = 0 .. sz in (
    let i = sz - _i - 1;
    let dur, ev = arr[i];
    let start = starts[i];
    let phrase_end = clock[0];
    let updated = update_durs ev start 0 all_cols phrase_end;
    arr[i] := (dur, updated);
    mark_rests updated start 0 all_cols
  );

  ()
;;
let parse_pattern = fn p ->
  let arr = parse_pat p |> Arrays.map (fn (d, x) -> (d, parse_line x));
  compute_column_wise_durs arr;
  arr
;;


let jump_next = fn counter size jump ->
  let probability = match jump with
    | JumpRel (_, p) -> p
    | JumpAbs (_, p) -> p
    | _ -> -1
    ;
  let succeeds = if probability < 0 then true else
    Math.rand_double () <= (Double probability / 256.);
  let target = match jump with
    | JumpRel (steps, _) -> if succeeds then counter + steps else counter + 1
    | JumpAbs (target, _) -> if succeeds then target else counter + 1
    | _ -> counter + 1
    ;
  if succeeds && (target < 0 || target >= size) then size else target
;;

let pat_line_iter = fn counter arr ->
  let dur, ev = arr[counter];
  let size = array_size arr;
  match ev with
  | JumpRel _ -> (
    let next_counter = jump_next counter size ev;
    if next_counter >= size then (size, dur, Rest)
    else pat_line_iter next_counter arr
  )
  | JumpAbs _ -> (
    let next_counter = jump_next counter size ev;
    if next_counter >= size then (size, dur, Rest)
    else pat_line_iter next_counter arr
  )
  | Group evs -> (
    if array_size evs == 0 then (counter + 1, dur, ev)
    else match evs[0] with
    | JumpRel _ -> (
      let jump = evs[0];
      let next_counter = jump_next counter size jump;
      if next_counter >= size then (size, dur, Rest)
      else pat_line_iter next_counter arr
    )
    | JumpAbs _ -> (
      let jump = evs[0];
      let next_counter = jump_next counter size jump;
      if next_counter >= size then (size, dur, Rest)
      else pat_line_iter next_counter arr
    )
    | _ -> (counter + 1, dur, ev)
  )
  | _ -> (counter + 1, dur, ev)
;;

let pattern_cor = fn counter arr ->
  let (c, d, ev) = pat_line_iter counter arr;
  yield (d, ev);
  if (c < array_size arr) then (yield pattern_cor c arr; ()) else ()
;;

# let pattern_cor_ctx = fn ctx counter arr ->
#   let (c, d, ev) = pat_line_iter counter arr;
#   yield (d, ev);
#   if (c < array_size arr) then (yield pattern_cor ctx c arr; ()) else ()
# ;;

let pattern_cor_ref = fn counter arr_ref ->
  let arr = arr_ref[0];
  let size = array_size arr;
  let safe_counter = counter % size;
  let (c, d, ev) = pat_line_iter safe_counter arr;
  yield ev;
  if (c < size) then (yield pattern_cor_ref c arr_ref; ()) else ()
;;

# let scan_for_delay = fn plist ->
#   match plist with
#   | [] -> 0.
#   | ('d', p)::rest -> p
#   | x::rest -> scan_for_maybe rest
# ;;

let pattern_cor_ctx = fn ctx: (PlayerCtx) counter arr ->
  let (c, d, ev) = pat_line_iter counter arr;
  let next_time = ctx.logical_time + ((Double d) * ctx.spl * ctx.bpm / 60.);
  let next_ctx = (bpm: ctx.bpm, spl: ctx.spl, logical_time: next_time);
  yield (d, next_ctx, ev);
  if (c < array_size arr) then (yield pattern_cor_ctx next_ctx c arr; ()) else ()
;;

let handle_ev = fn
  note_cb
  spl: (Double)
  ev ->
    match ev with
    | Note (note, instr, plist, note_dur, column) -> (
      match scan_for_maybe plist with
      | Some p -> (
        (if Math.rand_double () <= (Double p / 256.) then (note_cb (note_dur * spl) note instr plist) else ())
      )
      | None -> (note_cb (note_dur * spl) note instr plist; ())
    )
    | Group evs -> (
      for i = 0 .. array_size evs in (
        let e = evs[i];
        handle_ev note_cb spl e
      );
      ()
    )
    | Choice evs -> (
      let ev = Math.array_choose evs;
      handle_ev note_cb spl ev;
      ()
    )
    | _ -> ()
;;

let scan_for_maybe_ctx = fn plist: (Params) -> scan_for_maybe plist
;;

let delay_note = fn delay note_cb ctx note_dur note instr plist ->
  yield delay;
  note_cb ctx note_dur note instr plist
;;

let handle_ev_ctx_note = fn note_cb ctx spl note_dur note instr plist ->
  match scan_for_delay plist with
  | Some d -> (
    let delayed_plist = copy_params plist;
    play_pattern 0. (
      let delayed = delay_note (spl * (Double d) / 256.) note_cb ctx
        (note_dur * spl) note instr delayed_plist in delayed
    );
    ()
  )
  | None -> note_cb ctx (note_dur * spl) note instr plist
;;

let handle_ev_ctx_inner = fn note_cb: (PlayerCtx -> Double -> Int -> Int -> Params -> ())
  ctx ev ->
  match ev with
  | Note (note, instr, plist, note_dur, column) -> (
    let probability = scan_for_maybe plist;
    let plays = match probability with
      | Some p -> Math.rand_double () <= (Double p / 256.)
      | None -> true
      ;
    if plays then (
      let bpm = ctx.bpm;
      let spl = ctx.spl;
      let ctx = (bpm: bpm, spl: spl, logical_time: ctx.logical_time);
      let plist_copy = copy_params plist;
      handle_ev_ctx_note note_cb ctx spl note_dur note instr plist_copy
    ) else ()
  )
  | Group evs -> (
    for i = 0 .. array_size evs in (
      let e = evs[i];
      handle_ev_ctx_inner note_cb ctx e
    );
    ()
  )
  | Choice evs ->
    handle_ev_ctx_inner note_cb ctx (Math.array_choose evs)
  | _ -> ()
  ;
  ()
;;

let handle_ev_ctx = fn note_cb
  (d, ctx, ev) ->
  handle_ev_ctx_inner note_cb ctx ev;
  d * ctx.spl
;;

let test = module () ->
  let test_char_to_lower = fn () ->
    char_to_lower 'A' == 'a' &&
    char_to_lower 'z' == 'z' &&
    char_to_lower '7' == '7'
  ;;

  let test_hex_digits = fn () ->
    parse_hex_digits 2 "0f" == 15 &&
    parse_hex_digits 2 "a0" == 160 &&
    parse_hex_digits 2 "Ff" == 255
  ;;

  let test_midi = fn () ->
    parse_midi "C4" == 60 &&
    parse_midi "c#5" == 73 &&
    parse_midi "A#4" == 70
  ;;

  let test_reverse_list_to_array = fn () ->
    let result = rlist_to_arr [3, 2, 1,] [| 0, 0, 0 |] 2;
    result[0] == 1 && result[1] == 2 && result[2] == 3
  ;;

  let test_chunk_chars = fn () ->
    let note, instr, params = parse_chunk_chars "01c#5 m80 V0f";
    note == 73 && instr == 1 &&
    let n0, v0 = params[0];
    let n1, v1 = params[1];
    array_size params == 2 && n0 == 'v' && v0 == 15 &&
    n1 == 'm' && v1 == 128
  ;;

  let test_retrig_param = fn () ->
    let _, instr, params = parse_chunk_chars "05 r02";
    let name, value = params[0];
    instr == 5 && array_size params == 1 && name == 'r' && value == 2
  ;;

  let test_parse_param_set = fn () ->
    match parse_line "_; dff" with
    | Group atoms -> (
      match atoms[1] with
      | ParamSet (column, params) -> (
        let name, value = params[0];
        column == 1 && array_size params == 1 && name == 'd' && value == 255
      )
      | _ -> false
    )
    | _ -> false
  ;;

  let test_scan_for_maybe = fn () ->
    match scan_for_maybe [| ('v', 15), ('m', 128) |] with
    | Some p ->
      p == 128 &&
      match scan_for_maybe [| ('v', 15) |] with
      | None -> true
      | _ -> false
    | _ -> false
  ;;

  let test_parse_line_gap = fn () ->
    match parse_line "; 01c#5" with
    | Note (note, instr, _, _, column) ->
      note == 73 && instr == 1 && column == 1
    | _ -> false
  ;;

  let test_scan_atom = fn () ->
    scan_atom "00; 01c#5" 0 == 2 &&
    scan_atom "01c#5" 0 == 5
  ;;

  let test_parse_jump = fn () ->
    match parse_line "JB04 m00" with
    | JumpRel (steps, probability) -> steps == -4 && probability == 0
    | _ -> false
  ;;

  let test_parse_jump_abs = fn () ->
    match parse_line "JA02 m80" with
    | JumpAbs (target, probability) -> target == 2 && probability == 128
    | _ -> false
  ;;

  let test_parse_line_group = fn () ->
    match parse_line "00; _; 01c#5" with
    | Group atoms ->
      match atoms[1] with
      | Rest ->
        match atoms[2] with
        | Note (_, instr, _, _, column) -> instr == 1 && column == 2
        | _ -> false
      | _ -> false
    | _ -> false
  ;;

  let test_pattern = fn () ->
    let pattern = parse_pattern "00\n\n# comment\n05 r02\n";
    let _, ev = pattern[1];
    match ev with
    | Note (_, instr, plist, _, _) -> (
      instr == 5 &&
      let name, value = plist[0];
      array_size plist == 1 && name == 'r' && value == 2
    )
    | _ -> false
  ;;

  let test_pattern_crlf = fn () ->
    let pattern = parse_pattern "00c#4 ;\r\n00c#5 ;\r\n";
    array_size pattern == 2
  ;;

  let test_column_durs = fn () ->
    let pattern = [| (2, Note (60, 1, [| |], 1, 1)) |];
    let _, dur, ev = pat_line_iter 0 pattern;
    dur == 2 && ev_to_str ev == "Note"
  ;;

  let test_rest_dur = fn () ->
    let pattern = [| (1, Note (60, 1, [| |], 1, 0)) |];
    let _, _, ev = pat_line_iter 0 pattern;
    match ev with
    | Note (_, _, _, note_dur, _) -> note_dur == 1
    | _ -> false
  ;;

  let test_blank_time_dur = fn () ->
    let pattern = [| (1, Note (71, 1, [| |], 1, 1)) |];
    let _, _, ev = pat_line_iter 0 pattern;
    match ev with
    | Note (_, _, _, note_dur, _) -> note_dur == 1
    | _ -> false
  ;;

  let test_jump_iteration = fn () ->
    let pattern = [|
      (1, Rest),
      (1, JumpRel (2, -1)),
      (1, Note (60, 1, [| |], 1, 0)),
      (1, Note (60, 1, [| |], 1, 0))
    |];
    match pat_line_iter 1 pattern with
    | (next, _, Note _) -> next == 4
    | _ -> false
  ;;

  let test_jump_abs_probability = fn () ->
    let pattern = [|
      (1, Rest),
      (1, JumpAbs (3, 0)),
      (1, Note (60, 1, [| |], 1, 0)),
      (1, Note (61, 1, [| |], 1, 0))
    |];
    match pat_line_iter 1 pattern with
    | (next, _, Note (60, _, _, _, _)) -> next == 3
    | _ -> false
  ;;

  let test_group_jump_iteration = fn () ->
    let pattern = [|
      (1, Note (60, 1, [| |], 1, 0)),
      (1, Group [| JumpAbs (0, -1), Rest, Note (61, 4, [| |], 1, 2) |])
    |];
    match pat_line_iter 1 pattern with
    | (next, _, Note (60, _, _, _, _)) -> next == 1
    | _ -> false
  ;;

  let test_group_jump_parse = fn () ->
    match parse_line "ja00 ; ;04" with
    | Group atoms ->
      match atoms[0] with
      | JumpAbs (target, probability) -> target == 0 && probability == -1
      | _ -> false
    | _ -> false
  ;;

  let test_pattern_cor = fn () ->
    let pattern = [| (1, Note (60, 1, [| |], 1, 0)) |];
    let co = pattern_cor 0 pattern;
    match co () with
    | Some (dur, Note _) -> dur == 1
    | _ -> false
  ;;


;
