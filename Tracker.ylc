let handle_ev = fn
  note_cb
  dur
  ev ->
    match ev with
    | Note (note, instr, plist) -> (
      match scan_for_maybe plist with
      | Some p -> (if Math.rand_double () <= (Double p / 256.) then (note_cb dur note instr plist) else ())
      | None -> (note_cb dur note instr plist; ())
    )
    | Group evs -> (
      for i = 0 .. array_size evs in (
        let e = evs[i];
        handle_ev note_cb dur e
      );
      ()
    )
    | Choice evs -> (
      let ev = evs[Math.rand_int (array_size evs)];
      handle_ev note_cb dur ev;
      ()
    )
    | _ -> ()
    ;
    dur
;;
