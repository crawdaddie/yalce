open libs/audio_jit/DSP;
import std/Math;

# Parts 55-57: nine harmonic drawbars, upper percussion and a key-contact transient.
# shortcut: percussion retriggers per note; shared keyboard gating needs a controller.
let drawbar_organ = @Audio fn freq duration ->
  let trigger = trig 0;
  let gate = rect duration trigger;
  let ratios = ~[0.5, 1., 1.5, 2., 3., 4., 5., 6., 8.];
  # Registration 888400000: each step below eight reduces gain by about 3 dB.
  let db_per_step = 3.;
  let fourth_gain = Math.db_amp (-4. * db_per_step);
  let gain = ~[1., 1., 1., fourth_gain, 0., 0., 0., 0., 0.];
  let wheels = sin_osc (freq * ratios) * gain |> sum;
  let percussion = sin_osc (freq * 3.) * decay 0.18 trigger;
  let click = white () |> Filter.hpf 1500. 0.707
    |> (*) (decay 0.003 trigger);
  let envelope = asr 0.002 1. 0.02 gate |> kill_on_end;

  (wheels + 0.6 * percussion + 0.08 * click)
  |> (*) 0.2
  |> Math.tanh
  |> (*) (0.4 * envelope)
;;

# Leave one second of silence after each tail: demo () |> play_pattern 0.;
let demo = fn () ->
  let sound_time = 2.0;
  let gap = 1.;

  print "drawbar_organ\n";
  drawbar_organ 220. 1.5 |> play_node;
  yield (sound_time + gap)
;;
