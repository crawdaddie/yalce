open libs/audio_jit/DSP;
import std/Math;

# Part 62: phase-offset delay modulation prevents identical moving copies.
let chorus = @Audio fn rate input ->
  let phases = ~[0., 0.3333333333333333, 0.6666666666666666];
  let delay_time = 0.02 + 0.002 * fm_op rate phases;
  let wet = delay delay_time 0.03 input |> mix 1 |> (*) (1. / 3.);
  (input + wet) * 0.5
;;

# Shorter modulated delays produce comb notches; feedback sharpens them.
let flanger = @Audio fn rate input ->
  let delay_time = 0.003 + 0.002 * sin_osc rate;
  let feedback = 0.35;
  let wet = comb delay_time 0.01 feedback input;
  (input + wet * (1. - feedback)) * 0.5
;;

# Parts 58-59: independent bass/treble motion, with quadrature tonal modulation.
# shortcut: a mono dual-rotor sketch omits cabinet reflections; add spatial paths for a Leslie model.
let rotary = @Audio fn rate input ->
  let crossover = 800.;
  let filter_q = 0.707;
  let horn_rate = lag 0.2 rate;
  let bass_rate = lag 0.6 (rate * 0.8);
  let horn_phase = phasor horn_rate;
  let bass_phase = phasor bass_rate;
  let turn = 2. * Math.PI;
  let horn_motion = Math.sin (turn * horn_phase);
  let horn_level = 0.8 + 0.2 * Math.cos (turn * horn_phase);
  let bass_level = 0.85 + 0.15 * Math.cos (turn * bass_phase);
  let bass = input |> Filter.lpf crossover filter_q |> (*) bass_level;
  let horn = input
    |> Filter.hpf crossover filter_q
    |> delay (0.004 + 0.0003 * horn_motion) 0.01
    |> Filter.lpf (5000. * horn_level) filter_q
    |> (*) horn_level;

  (bass + horn) * 0.7
;;

# Part 61: a feedback delay repeats the input with decreasing level.
let echo = @Audio fn input ->
  let feedback = 0.35;
  let wet = comb 0.25 0.3 feedback input;
  (input + wet * (1. - feedback)) * 0.5
;;

# Parallel combs scatter echoes; the allpass blurs their regular spacing.
# shortcut: a small Schroeder-style room, not a measured space; add damping for material-specific tails.
let short_room = @Audio fn input ->
  let times = ~[0.0297, 0.0371, 0.0411];
  let feedback = 0.6;
  let wet = input
    |> comb times 0.05 feedback
    |> mix 1
    |> (*) ((1. - feedback) / 3.)
    |> dl_allpass 0.005 0.01 0.5;

  input * 0.7 + wet * 0.3
;;

# Stop excitation first, then let the chorus tail finish.
let chorus_demo = @Audio fn () ->
  let trigger = trig 0;
  let source = saw_osc 220. * asr 0.01 1. 0.05 (rect 1.2 trigger) * 0.15;
  chorus 0.8 source
  |> (*) (asr 0. 1. 0.15 (rect 3. trigger) |> kill_on_end)
;;

# Stop excitation first, then let the flanger tail finish.
let flanger_demo = @Audio fn () ->
  let trigger = trig 0;
  let source = saw_osc 220. * asr 0.01 1. 0.05 (rect 1.2 trigger) * 0.15;
  flanger 0.8 source
  |> (*) (asr 0. 1. 0.15 (rect 3. trigger) |> kill_on_end)
;;

# Stop excitation first, then let the rotary tail finish.
let rotary_demo = @Audio fn () ->
  let trigger = trig 0;
  let source = saw_osc 220. * asr 0.01 1. 0.05 (rect 1.2 trigger) * 0.15;
  rotary 6. source
  |> (*) (asr 0. 1. 0.15 (rect 3. trigger) |> kill_on_end)
;;

# Stop excitation first, then let the echo tail finish.
let echo_demo = @Audio fn () ->
  let trigger = trig 0;
  let source = saw_osc 220. * asr 0.01 1. 0.05 (rect 1.2 trigger) * 0.15;
  echo source
  |> (*) (asr 0. 1. 0.15 (rect 3. trigger) |> kill_on_end)
;;

# Stop excitation first, then let the short_room tail finish.
let short_room_demo = @Audio fn () ->
  let trigger = trig 0;
  let source = saw_osc 220. * asr 0.01 1. 0.05 (rect 1.2 trigger) * 0.15;
  short_room source
  |> (*) (asr 0. 1. 0.15 (rect 3. trigger) |> kill_on_end)
;;

# Leave one second of silence after each tail: demo () |> play_pattern 0.;
let demo = fn () ->
  let sound_time = 3.5;
  let gap = 1.;

  print "chorus\n";
  chorus_demo () |> play_node;
  yield (sound_time + gap);

  print "flanger\n";
  flanger_demo () |> play_node;
  yield (sound_time + gap);

  print "rotary\n";
  rotary_demo () |> play_node;
  yield (sound_time + gap);

  print "echo\n";
  echo_demo () |> play_node;
  yield (sound_time + gap);

  print "short_room\n";
  short_room_demo () |> play_node;
  yield (sound_time + gap)
;;
