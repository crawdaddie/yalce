open libs/audio_jit/DSP;
import std/Math;

# Analog Four MKII: chapter 14, Appendix A and Appendix E.
# https://www.elektron.se/media/2026/10/Analog-Four-MKII-User-Manual_ENG_OS1.56_260930.pdf
# Digital approximations of the voice architecture, not circuit/knob calibration.
let A4 = module () ->
  let magnitude = @Audio fn x -> Math.max x (0. - x);;
  let wrap = @Audio fn phase -> phase - Math.floor phase;;

  # Tuning is in semitones; linear detune is a separate Hz offset.
  let tune = @Audio fn freq semitones detune_hz ->
    Math.max 0. (freq * midiratio semitones + detune_hz)
  ;;
  let pwm = @Audio fn pw rate depth -> Math.clamp -1. 1. (pw + depth * sin_osc rate);;

  # PW is -1..1. Phase inputs let sync and free-running oscillators share shapes.
  let saw_shape = @Audio fn phase pw ->
    let width = magnitude (Math.clamp -1. 1. pw);
    let shift = 2. * width * (1. - width);
    let first = 2. * wrap phase - 1.;
    let second = 2. * wrap (phase + shift) - 1.;
    (first + second) * 0.5
  ;;
  let pulse_shape = @Audio fn phase pw ->
    let duty = (Math.clamp -1. 1. pw + 1.) * 0.5;
    if duty <= 0. || duty >= 1. then 0.
    else if wrap phase < duty then 1. else -1.
  ;;
  let transistor_shape = @Audio fn phase pw ->
    let duty = (Math.clamp -1. 1. pw + 1.) * 0.5;
    let p = wrap phase;
    # Audio branches may evaluate both sides, including muted endpoints.
    let min_duty = 0.000001;
    if duty <= 0. || duty >= 1. then 0.
    else if p < duty then 1. - p / Math.max min_duty duty else -1.
  ;;
  let triangle_shape = @Audio fn phase pw ->
    let p = wrap phase;
    let edge = magnitude (Math.clamp -1. 1. pw);
    let triangle = 1. - 4. * magnitude (p - 0.5);
    let reverse_saw = 1. - 2. * p;
    triangle * (1. - edge) + reverse_saw * edge
  ;;

  let saw = @Audio fn freq pw -> saw_shape (phasor (Math.max 0. freq)) pw;;
  let pulse = @Audio fn freq pw -> pulse_shape (phasor (Math.max 0. freq)) pw;;
  let transistor = @Audio fn freq pw ->
    transistor_shape (phasor (Math.max 0. freq)) pw
  ;;
  let triangle = @Audio fn freq pw -> triangle_shape (phasor (Math.max 0. freq)) pw;;

  # Subs ignore the main oscillator's PW/PWM. Their pitch follows its tuning.
  let sub_oct = @Audio fn freq -> pulse (freq * 0.5) 0.;;
  let sub_two_oct = @Audio fn freq -> pulse (freq * 0.25) 0.;;
  let sub_two_pulse = @Audio fn freq -> pulse (freq * 0.25) -0.5;;
  let sub_fifth = @Audio fn freq -> pulse (freq * (2. / 3.)) (-1. / 3.);;

  # Either oscillator can be master. amount=0 is free-running; 1 is hard sync.
  # shortcut: partial phase reset approximates soft sync; Metal Sync needs measurements.
  let sync_phase = @Audio fn master_hz slave_hz amount ->
    let phase = [| 0., 0. |];
    let max_hz = 0.45 / spf;
    let master_step = Math.min max_hz (Math.max 0. master_hz) * spf;
    let slave_step = Math.min max_hz (Math.max 0. slave_hz) * spf;
    let output = phase[1];
    let master_next = phase[0] + master_step;
    let slave_next = wrap (phase[1] + slave_step);
    phase[0] := wrap master_next;
    phase[1] := if master_next >= 1. then slave_next * (1. - Math.clamp 0. 1. amount)
      else slave_next;
    output
  ;;
  let sync_saw = @Audio fn master slave amount pw ->
    saw_shape (sync_phase master slave amount) pw
  ;;
  let sync_pulse = @Audio fn master slave amount pw ->
    pulse_shape (sync_phase master slave amount) pw
  ;;

  # A4 AM switches a source on/off with the other oscillator's pulse, not bipolar RM.
  let am = @Audio fn source modulator_pulse amount ->
    let depth = Math.clamp 0. 1. amount;
    source * (1. - depth + depth * (Math.clamp -1. 1. modulator_pulse + 1.) * 0.5)
  ;;

  # Fade uses seconds: positive fades out, negative fades in, zero stays constant.
  let fade = @Audio fn seconds ->
    let envelope = decay (Math.max spf (magnitude seconds)) (trig 0);
    if seconds > 0. then envelope else if seconds < 0. then 1. - envelope else 1.
  ;;
  let noise = @Audio fn hold_hz color fade_seconds ->
    let w = white ();
    let p = pink ();
    let red_cutoff = 20.;
    let red_gain = 8.;
    let high_cutoff = 1000.;
    let red = Filter.lpf1p red_cutoff w * red_gain;
    let high = Filter.hpf1p high_cutoff w;
    let c = Math.clamp -1. 1. color;
    let colored = if c < -0.5 then p * (2. + 2. * c) + red * (-2. * c - 1.)
      else if c < 0. then w * (1. + 2. * c) - p * (2. * c)
      else w * (1. - c) + high * c;
    let held = sah colored (trig (Math.max 0. hold_hz));
    (if hold_hz > 0. then held else colored) * fade fade_seconds
  ;;

  # Filter 1: four-pole ladder. res=0..1, overdrive=-1..1.
  # Negative overdrive drives the ladder; positive overdrive clips its output.
  let ladder_core = @Audio fn cutoff res overdrive input ->
    let max_cutoff = 0.4 / spf;
    let max_feedback = 4.;
    let drive_gain = 8.;
    let drive = 1. + drive_gain * Math.max 0. (0. - Math.clamp -1. 1. overdrive);
    input |> Filter.ladder (Math.max 5. (Math.min max_cutoff cutoff))
      (max_feedback * Math.clamp 0. 1. res) drive
  ;;
  let post_drive = @Audio fn overdrive input ->
    let drive_gain = 8.;
    Math.clamp -1. 1. (input * (1. + drive_gain * Math.max 0. (Math.clamp -1. 1. overdrive)))
  ;;
  let filter1 = @Audio fn cutoff res overdrive input ->
    input |> ladder_core cutoff res overdrive |> post_drive overdrive
  ;;
  # FDB returns the ladder output to the mixer before post-filter overdrive.
  let feedback_filter1 = @Audio fn cutoff res overdrive feedback input ->
    let previous = [| 0. |];
    let output = ladder_core cutoff res overdrive (input + previous[0] * feedback);
    previous[0] := output;
    post_drive overdrive output
  ;;

  # Filter 2: shared two-pole state-variable core, including resonant 6 dB modes.
  # Q is physical Q, not the hardware RES scale; cutoff is Hz.
  let svf = @Audio fn cutoff q low_gain band_gain high_gain input ->
    let state = [| 0., 0. |];
    let max_cutoff = 0.4 / spf;
    let f = Math.max 5. (Math.min max_cutoff cutoff);
    let damping = 1. / Math.max 0.5 (Math.min 20. q);
    let g = Math.tan (Math.PI * f * spf);
    let norm = 1. / (1. + g * (g + damping));
    let residual = input - state[1];
    let band = norm * state[0] + g * norm * residual;
    let low = state[1] + g * norm * state[0] + g * g * norm * residual;
    let high = input - damping * band - low;
    state[0] := 2. * band - state[0];
    state[1] := 2. * low - state[1];
    low * low_gain + band * band_gain + high * high_gain
  ;;
  let lp2 = @Audio fn cutoff q input -> svf cutoff q 1. 0. 0. input;;
  let lp1 = @Audio fn cutoff q input -> svf cutoff q 1. 1. 0. input;;
  let bp = @Audio fn cutoff q input -> svf cutoff q 0. 1. 0. input;;
  let hp1 = @Audio fn cutoff q input -> svf cutoff q 0. 1. 1. input;;
  let hp2 = @Audio fn cutoff q input -> svf cutoff q 0. 0. 1. input;;
  let bs = @Audio fn cutoff q input -> svf cutoff q 1. 0. 1. input;;
  let pk = @Audio fn cutoff q input -> svf cutoff q 1. 0. (-1.) input;;

  let amp = @Audio fn gate attack release level input ->
    let envelope = gate |> asr attack 1. release |> kill_on_end;
    input * envelope * level
  ;;

  # Compose two oscillators, then Filter 1 -> Filter 2 -> amplitude envelope.
  let s_bass = @Audio fn freq dur pw detune_hz cutoff resonance drive ->
    let trigger = trig 0;
    let gate = rect dur trigger;
    let f2 = tune freq 0. detune_hz;
    let width = pwm pw 0.7 0.15;
    let source = saw freq width * 0.4 + pulse f2 (0. - width) * 0.3
      + sub_oct freq * 0.3;
    let filter_motion = 1. + 3. * decay 0.18 trigger;
    source |> filter1 (cutoff * filter_motion) resonance drive
      |> hp2 30. 0.707
      |> amp gate 0.003 0.15 1.
  ;;

  let bass_node = synth_default [|(41. |> midicps), 4., 0., 0.6, 700., 0.4, -0.2|] s_bass;
  let bass = fn pl -> bass_node pl |> play_node;;

  let s_sync_lead = @Audio fn freq dur interval amount cutoff ->
    let trigger = trig 0;
    let slave = tune freq (interval + 12. * decay 0.2 trigger) 0.;
    sync_saw freq slave amount (pwm 0. 0.4 0.2)
      |> filter1 cutoff 0.2 0.1
      |> lp2 (cutoff * 1.5 * lfnoise 1 0.1 1.5) 2.
      |> amp (rect dur trigger) 0.003 1. 0.2
  ;;

  let s_am_bell = @Audio fn freq dur ratio depth ->
    let trigger = trig 0;
    let source = triangle freq 0.2;
    am source (pulse (freq * ratio) 0.) depth
      |> (*) (decay dur trigger)
      |> filter1 9000. 0.1 0.
      |> pk 1800. 1.2
      |> amp (rect dur trigger) 0.002 1. 0.2
  ;;
;

let rs = @Audio fn inp -> inp |> comb 0.25 0.25 0.9 |> Reverb.cathedral;;
let r = rs 0. |> play_node;
# let |> play_node = play_node;

let x = fn () ->
  A4.bass [("freq", 34. |> midicps),];
  A4.s_sync_lead (66. |> midicps) 2. 19. 1. 4000. ~> r;
  yield 4.;
  A4.bass [("freq", 41. |> midicps),];
  A4.s_sync_lead (66. |> midicps) 4. 19. 1. 4000. ~> r;
  yield 2.;
  A4.s_sync_lead (63. |> midicps) 4. 19. 1. 4000. ~> r;
  A4.s_sync_lead (65. |> midicps) 4. 19. 1. 4000. ~> r;
  yield 2.;
  A4.bass [("freq", 42. |> midicps), ("dur", 3.)];
  A4.s_sync_lead (65. |> midicps) 4. 19. 1. 4000. ~> r;
  yield 3.;
  A4.bass [("freq", 39. |> midicps), ("dur", 1.)];
  A4.s_sync_lead (63. |> midicps) 2. 19. 1. 4000. ~> r;
  yield 1.;
  A4.bass [("freq", 46. |> midicps),];
  A4.s_sync_lead (70. |> midicps) 4. 19. 1. 4000. ~> r;
  A4.s_sync_lead (65. |> midicps) 2. 19. 1. 4000. ~> r;
  yield 2.;
  A4.s_sync_lead (63. |> midicps) 4. 19. 1. 4000. ~> r;
  A4.s_sync_lead (65. |> midicps) 4. 19. 1. 4000. ~> r;
  yield 2.;

  yield x ()
;;
x () |> play_pattern 0.;
# A4.am_bell 220. 2. 2.73 1. |> play_node;
# Use any input signal in the filters/AM for external or neighbor-style routing.
# shortcut: naive wave edges/sync alias; add oversampling before hardware matching.
# Transistor pulse, PW laws, noise color and filter responses are approximations.
