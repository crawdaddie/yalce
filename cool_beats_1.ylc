# play (kick |> iter |> cor_loop |> cor_map (fn (d, a) -> (d * 0.25, a)));

# Pair each value with the prior total so durations produce total start offsets since beginning of pattern
let cor_acc = fn i f c: (Coroutine of T) -> 
  match c () with
  | Some v -> (
    yield (v, i); yield cor_acc (f i v) f c; ()  
    )
  | _ -> ()
;;


# select between 2 coroutines with a probability
let cor_chance2 = fn probability: (Double) a: (Coroutine of T) b: (Coroutine of T) ->
  match Math.rand_double () < probability with
  | true -> a
  | false -> b
;;

let kick =
(fn () ->
  yield cor_chance2 0.5 (iter [3.,]) (iter [1., 2.,]);
  yield 3.;

  yield cor_chance2 0.5 (iter [3.,]) (iter [1., 1., 1.,]);
  yield 4.;

  yield cor_chance2 0.5 (iter [3.,]) (iter [2., 1.,]);
  yield kick ()
) in kick ()
|> cor_acc 0. (fn p d -> (p + d) % 32.)
|> cor_map (fn (d, acc) -> 
  Drums.kds 0. (0.3 * acc) |> play_node;
  d * beat * 0.25
)
|> play_pattern beat 
;



[3., 3., 3., 4., 2., 1.,
3.,  3., 4., 3., 2., 1.]
|> iter
|> cor_loop
|> cor_map (fn d -> 
  pianos
    0.
    (Math.array_choose [|0., 0., 0., 0., 5., 7., 8., |] |> midiratio)
    (beat * 0.25 * 0.5)
    ~> piano_fx;
  d * beat * 0.25
)
|> play_pattern beat
;
