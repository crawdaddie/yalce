open libs/audio_jit/DSP;
import libs/audio_jit/SF;
import Tracker;
import std/Lists;
import std/Arrays;

let bpm = 130.;
let beat = 60. / bpm;
let Drums = module () ->
  let bufs = [|
    "~/Sounds/renoise-3.5.4-samples/Kicks/Long/clean.flac",
    "~/Sounds/renoise-3.5.4-samples/Snares/Bodied/reggae.flac",
    "~/Sounds/renoise-3.5.4-samples/HiHats/Closed Hat/around.flac",
    "~/Sounds/renoise-3.5.4-samples/HiHats/Open Hat/mid.flac",
    "~/Sounds/renoise-3.5.4-samples/Stabs/housepiano_D.flac"
  |] |> Arrays.map (SF.load_sf);

  let _ = print `loaded {array_size bufs} buffers\n`;

  let kds = @Audio fn bias mul -> 
    let rate = 1.;
    let f = bufs[0]; 
    let t = trig 0;

    t
    |> bufplay f.data (f.samplerate * spf) 0.
    #|> (*) 2. |> Math.tanh
    |> mixadd (fn i -> Math.sin (bias + i * mul)) 
    |> (*) (t |> rect 0.2 |> adsr 0. 0. 1. 0.01 |> kill_on_end)
    |> (*) (Math.db_amp -3.)
  ;;

  let k = fn b mul ->
    kds b mul |> play_node;
    ()
  ;;

  let hhcls = @Audio fn retrigf rate -> 
    let hbuf = bufs[2]; 
    let t = trig 0;

    (trig retrigf)
    |> bufplay hbuf.data (hbuf.samplerate * spf * rate) 0.
    |> (*) (t |> rect 0.05 |> adsr 0. 0. 1. 0.01 |> kill_on_end)
    |> (*) (Math.db_amp -3.)
  ;;

  let hhcl = fn dur ->
    hhcls 0. 1.5 |> play_node;
    ()
  ;;

  let hhops = @Audio fn retrigf rate -> 
    let hbuf = bufs[3]; 
    let t = trig 0;

    (trig retrigf)
    |> bufplay hbuf.data (hbuf.samplerate * spf) 0.
    |> (*) (t |> rect 0.1 |> adsr 0. 0.05 0.5 0.01 |> kill_on_end)
    |> (*) (Math.db_amp -3.)
  ;;

  let hhop = fn dur ->
    hhops 0. 1. |> play_node;
    ()
  ;;

  let sns = @Audio fn retrigf rate -> 
    let hbuf = bufs[1]; 
    let t = trig 0;

    (trig retrigf)
    |> bufplay hbuf.data (hbuf.samplerate * spf * rate) 0.
    # |> (*) (sin_osc 200.)
    |> (*) (t |> rect 0.1 |> adsr 0. 0.05 0.5 0.01 |> kill_on_end)
    |> (*) (Math.db_amp 5.)
    # |> pan 2 (rand_trig 0. 1. t)
  ;;
  let r = Reverb.concert 0. |> play_node;

  let snare = fn dur ->
    sns 0. 1. ~> r;
    ()
  ;;
;

let pianos = @Audio fn retrigf rate d -> 
  let hbuf = Drums.bufs[4]; 
  let t = trig 0;

  (trig retrigf)
  |> mbufplay 2 hbuf.data (hbuf.samplerate * spf * rate * lfnoise 1. 0.99 1.01) 0.
  # |> (*) (sin_osc 200.)
  |> (*) (t |> rect d |> adsr 0. 0.05 0.5 0.01 |> kill_on_end)
  |> (*) (Math.db_amp 3.)
  # |> pan 2 (rand_trig 0. 1. t)
;;

let piano_fxs = @Audio fn iinp -> 
  # let inp = iinp |> disperser 400. 1. 1. |> disperser 400. 1. 1.;
  let inp = iinp;
  
  let pl = 0.1 * Reverb.plate 0.1 inp;

  (inp + pl)
  # |> comb 0.23075 0.5 0.4

;;

let piano_fx = piano_fxs 0. |> play_node;


let seq = fn events -> events |> iter;;

let hit = fn dur action -> (dur, action);;

let noop = fn () -> ();;

let rest = fn dur -> (dur, noop);;

let steps = fn values action ->
  let next = fn i ->
    if i >= array_size values then () else (
      yield (values[i], action values[i]);
      yield next (i + 1);
      ()
    )
  ;;

  next 0
;;


let play = fn pattern ->
  pattern
  |> cor_map (fn (dur, action) ->
       action ();
       dur * beat
     )
  |> play_pattern beat 
;;

let tts = [
  hit 0.25 Drums.hhcl,
  hit 0.25 Drums.hhcl,
  hit 0.25 Drums.hhop,
  hit 0.25 (\Math.chance 0.125 Drums.hhcl)
];

# let snr = [
#   rest 3.,
#   hit 1. Drums.snare,
#   # rest 3.,
#   # hit 0.75 Drums.snare,
#   # hit 0.25 Drums.snare
# ];

let snr = [
  rest 3.,
  hit 1. Drums.snare,
  # rest 2.,
  # hit 1. Drums.snare,
  # rest 3.,
  # hit 0.75 Drums.snare,
  # hit 0.25 Drums.snare
];


play (tts |> iter |> cor_loop);
play (snr |> iter |> cor_loop);

