let with_dur = fn c ->
  c |> cor_map (fn d -> (dur: d, time: 0.))
;;

let pat = [|3.,3.,3.,4.,3.|] |> iter |> with_dur;
print `
{pat ()}
{pat ()}
{pat ()}
{pat ()}
{pat ()}
{pat ()}
{pat ()}
`
