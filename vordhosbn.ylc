  c () |> play_pattern 0.;
  yield 8. * beat;

  c () |> play_pattern 0.;
  yield 8. * beat;
  drums () |> play_pattern 0.;

  c () |> play_pattern 0.;
  yield 8. * beat;

  c () |> play_pattern 0.;
  yield 8. * beat;

  let g2 = fn () ->
    m () |> play_pattern 0.;
    c () |> play_pattern 0.;
    yield 8. * beat;


    m () |> play_pattern 0.;
    c () |> play_pattern 0.;
    yield 8. * beat;

    m2 () |> play_pattern 0.;
    c () |> play_pattern 0.;
    yield 8. * beat;

    m2 () |> play_pattern 0.;
    c () |> play_pattern 0.;
    yield 8. * beat;


    m3 () |> play_pattern 0.;
    c () |> play_pattern 0.;
    yield 8. * beat;
    yield g2 ()
  ;;

  fx_set_routine () |> play_pattern 0.;
  yield g2 ()
;;

g () |> play_pattern beat;

