let snr_routine = fn () ->
  yield 1.;
  snr () ~> fx_node;
  yield 2.;
  snr () ~> fx_node;
  yield 1.;

  yield 1.;
  snr () ~> fx_node;
  yield 2.;

  snr () ~> fx_node;
  yield 1.;

  yield 1.;

  snr () ~> fx_node;
  yield 2.;

  snr () ~> fx_node;
  yield 1.;

  yield 1.;

  snr () ~> fx_node;
  yield 2.;

  snr () ~> fx_node;
  yield 1.
;;

let hh_routine = fn () ->
  array_fill_const 64 0.25
  |> iter
  |> cor_map (fn d ->
    Math.chance 0.6 (
      \Math.chance2 0.5
      (\hh () ~> fx_node)
      (\hh2 () ~> fx_node)
    );
    d * beat * 0.5
  )
;;

let drums = fn () ->
  kick_routine () |> cor_map (fn d -> d * beat * 0.5) |> play_pattern 0.; # 16 beats
  snr_routine () |> cor_map (fn d -> d * beat * 0.5) |> play_pattern 0.; # 16
  hh_routine () |> play_pattern 0.; #16
  yield 16. * beat * 0.5;

