let kd = @Audio fn () -> 
  let rate = 1.;
  let f = bufs[7]; 
  let t = trig 0;

  t
  |> bufplay f.data (f.samplerate * spf) 0.
  |> (*) (t |> rect 0.1 |> adsr 0. 0. 1. 0.01 |> kill_on_end)
  |> (*) (Math.db_amp 12.)
  # |> Filter.lpf 500. 1.
;;

let snr = @Audio fn () -> 
  let rate = 1.;
  let f = bufs[8]; 
  let t = trig 0;

  t
  |> bufplay f.data (f.samplerate * spf) 0.
  |> (*) (t |> rect 0.1 |> adsr 0. 0. 1. 0.01 |> kill_on_end)
  # |> (*) (Math.db_amp 12.)
;;

let hh = @Audio fn () -> 
  let rate = 1.;
  let f = bufs[1]; 
  let t = trig 0;

  t
  |> bufplay f.data (f.samplerate * spf) 0.
  |> (*) (t |> rect 0.05 |> adsr 0. 0. 1. 0.01 |> kill_on_end)
  # |> (*) (Math.db_amp 12.)
;;

let hh2 = @Audio fn () -> 
  let rate = 1.2;
  let f = bufs[1]; 
  let t = trig 0;

  t
  |> bufplay f.data (rate * f.samplerate * spf) 0.
  |> (*) (t |> rect 0.05 |> adsr 0. 0. 1. 0.01 |> kill_on_end)
  # |> (*) (Math.db_amp 12.)
;;




let cymbal = @Audio fn freq ->
  let t = trig 0;
  # t
  # |> decay 0.5
  # |> (*) (sin_osc (freq * ~[1., 1.5, 2.01, 3.5, 4.2]))
  # |> (*) (~[1., 0.6, 0.8, 0.5, 0.3])
  # |> sum

  freq
  |> pm_osc 1.01 1.2
  |> (+) (pink () 
    |> Filter.bpf freq 16.
    |> (*) (Math.db_amp 40.)
  )
  # freq |> pm_osc 2.03 1.2 * (decay 0.1 t))
  |> (*) (t |> rect 0.5 |> adsr 0. 0.1 0.2 1. |> kill_on_end)
  |> (*) (Math.db_amp -15.)
  
;;

let mels = @Audio fn freq dur ->
  let t = trig 0;

  freq * (~[ lfnoise 0.5 0.99 1.01, lfnoise 0.5 0.99 1.01])
  |> saw_osc 
  |> sum
  |> Filter.lpf 5000. 1.
  |> (*) (t |> rect dur |> adsr 0.01 0.1 0.5 0.5 |> kill_on_end)
  |> (*) (Math.db_amp -16.)
  
;;

let r = Reverb.cathedral 0. |> play_node;

let beat = 60. / 90.;
# cymbal 200. |> play_node
let note = fn d n ->

  cymbal (n |> midi_freq) ~> r;
  d * beat
;;

let mel = fn d n ->
  mels (n |> midi_freq) (d * beat) ~> r;
  d * beat
;;

let notes =
[|
  47., 62., 59., 62.,
  47., 62., 59., 62.,
  49., 61., 49., 61., 49., 61.,
  53., 54.,
|];

let m = fn () ->
  yield mel 2. 59.;
  yield mel 0.75 59.;
  yield mel 0.75 59.;
  yield mel .5 57.;
  yield mel 2. 61.;
  yield mel 0.75 61.; 
  yield mel 1. 61.;
  yield mel .25 62.

;;
let m2 = fn () ->
  yield mel 1. 73.;
  yield mel 2. 71.;
  yield mel .25 71.;
  yield mel .3 73.;
  yield mel .3 71.;
  yield mel 2. 71.;
  yield 2.15 * beat
;;

let m3 = fn () ->
  yield mel 1. 62.;
  yield mel 0.75 61.;
  yield mel 1.25 61.;
  yield mel 5. 88.
;;


let c = fn () ->
  yield note 0.5 @@ notes[0];
  yield note 0.5 @@ notes[1];
  yield note 0.5 @@ notes[2];

  let sync = 0.25 * (Double (Math.rand_double () <= 0.3));
  yield note (0.5 - sync) @@ notes[3];

  yield note (0.5 + sync) @@ notes[4];
  yield note 0.5 @@ notes[5];
  yield note 0.5 @@ notes[6];
  yield note 0.5 @@ notes[7];

  yield note 0.5 @@ notes[8];
  yield note 0.5 @@ notes[9];
  yield note 0.5 @@ notes[10];
  yield note 0.5 @@ notes[11];

  yield note 0.5 @@ notes[12];
  yield note 0.5 @@ notes[13];
  yield note 0.5 @@ notes[14];
  yield note 0.5 @@ notes[15]

  # yield c ()
;;
